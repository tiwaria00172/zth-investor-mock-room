/* ==========================================================================
   ZTH Investor Mock Room — Premium Dynamic UI Design System
   ========================================================================== */

:root {
  /* Color System */
  --zth-navy-primary: #0b1b33;
  --zth-navy-deep: #071224;
  --zth-blue-electric: #2563eb;
  --zth-blue-hover: #1d4ed8;
  --zth-blue-bright: #3b82f6;
  --zth-blue-pale: #eff6ff;
  --zth-bg-main: #f1f5f9;
  --zth-card-bg: #ffffff;
  --zth-text-main: #0f172a;
  --zth-text-secondary: #475569;
  --zth-text-muted: #64748b;
  --zth-border: #e2e8f0;
  --zth-border-subtle: #edf2f7;
  --zth-border-focus: #93c5fd;
  --zth-success: #15803d;
  --zth-warning: #b45309;
  --zth-critical: #b91c1c;

  /* Surface tokens */
  --zth-surface-subtle: #f8fafc;
  --zth-radius-sm: 6px;
  --zth-radius-md: 10px;
  --zth-radius-lg: 14px;

  /* Glass surface tokens */
  --glass-bg: rgba(255, 255, 255, 0.78);
  --glass-bg-strong: rgba(255, 255, 255, 0.88);
  --glass-blur: blur(18px) saturate(160%);
  --glass-border: rgba(255, 255, 255, 0.72);
  --glass-border-subtle: rgba(226, 232, 240, 0.70);
  --glass-shadow: 0 8px 28px rgba(15, 35, 65, 0.06), inset 0 1px 0 rgba(255, 255, 255, 0.75);
  --glass-shadow-hover: 0 12px 32px rgba(15, 35, 65, 0.09), inset 0 1px 0 rgba(255, 255, 255, 0.85);

  /* Typography Scale */
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-serif: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-geometric: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;

  /* Shadows */
  --shadow-sm: 0 1px 2px 0 rgba(11, 27, 51, 0.04);
  --shadow-md: 0 4px 12px -2px rgba(11, 27, 51, 0.06), 0 2px 4px -1px rgba(11, 27, 51, 0.03);
  --shadow-lg: 0 12px 24px -4px rgba(11, 27, 51, 0.08), 0 4px 10px -2px rgba(11, 27, 51, 0.04);
  --shadow-glass: 0 8px 28px rgba(15, 35, 65, 0.06);
  --shadow-blue-glow: 0 4px 16px -2px rgba(37, 99, 235, 0.2);

  /* Transitions */
  --transition-fast: 0.16s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-normal: 0.22s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Accessibility & Hidden Elements */
.sr-only {
  position: absolute !important;
  width: 1px !important;
  height: 1px !important;
  padding: 0 !important;
  margin: -1px !important;
  overflow: hidden !important;
  clip: rect(0, 0, 0, 0) !important;
  white-space: nowrap !important;
  border: 0 !important;
  opacity: 0 !important;
  pointer-events: none !important;
}

/* Base Styles */
*, *::before, *::after {
  box-sizing: border-box;
}

html {
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  margin: 0;
  padding: 0;
  font-family: var(--font-sans);
  background-color: var(--zth-bg-main);
  color: var(--zth-text-main);
  line-height: 1.5;
  font-size: 13.5px;
}

/* Consistent Symbol & Icon Proportions */
svg.lucide {
  vertical-align: middle;
  flex-shrink: 0;
}

button svg.lucide,
label svg.lucide,
.nav-item svg.lucide,
.segmented-tab-btn svg.lucide,
.viewer-nav-btn svg.lucide,
.viewer-zoom-btn svg.lucide,
.header-settings-btn svg.lucide,
.header-quick-upload svg.lucide {
  width: 1.2em;
  height: 1.2em;
}

button, input, select, textarea {
  font-family: inherit;
  font-size: inherit;
  color: inherit;
}

button {
  cursor: pointer;
  background: none;
  border: none;
}

a {
  color: var(--zth-blue-electric);
  text-decoration: none;
}

:focus-visible {
  outline: 2px solid var(--zth-blue-electric);
  outline-offset: 2px;
}

/* App Root Shell */
.app-root {
  display: flex;
  min-height: 100vh;
  background-color: #eef2f7;
  background-image:
    radial-gradient(ellipse 110% 55% at 50% -5%, rgba(37, 99, 235, 0.07), transparent 65%),
    radial-gradient(ellipse 70% 40% at 85% 100%, rgba(99, 179, 237, 0.05), transparent 60%),
    radial-gradient(rgba(148, 163, 184, 0.20) 1px, transparent 1px);
  background-size: 100% 100%, 100% 100%, 26px 26px;
  background-position: 0 0, 0 0, 0 0;
  position: relative;
}

/* ==========================================================================
   Sidebar Component
   ========================================================================== */
.app-sidebar {
  width: 236px;
  background-color: var(--zth-navy-deep);
  color: #ffffff;
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  transition: width var(--transition-normal);
  z-index: 60;
  position: sticky;
  top: 0;
  height: 100vh;
  overflow-y: auto;
  border-right: 1px solid rgba(255, 255, 255, 0.07);
}

.app-sidebar.collapsed {
  width: 60px;
}

.app-sidebar.collapsed .nav-item {
  justify-content: center;
  padding: 10px 0;
}

.sidebar-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 14px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.brand-logo-mark {
  width: 28px;
  height: 28px;
  border-radius: 7px;
  background: linear-gradient(135deg, var(--zth-blue-electric), #1d4ed8);
  color: #ffffff;
  display: grid;
  place-items: center;
  font-weight: 800;
  font-size: 14px;
  letter-spacing: -0.02em;
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.35);
  flex-shrink: 0;
}

.brand-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.brand-name {
  font-weight: 600;
  font-size: 13px;
  color: #ffffff;
  white-space: nowrap;
  letter-spacing: -0.01em;
}

.brand-sub {
  font-size: 11px;
  color: #94a3b8;
  white-space: nowrap;
}

.collapse-toggle {
  color: #94a3b8;
  padding: 4px;
  border-radius: 4px;
  transition: color var(--transition-fast), background var(--transition-fast);
}

.collapse-toggle:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.08);
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  padding: 14px 8px;
  gap: 16px;
  flex: 1;
}

.nav-group {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.nav-group-title {
  font-size: 10.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #64748b;
  padding: 4px 10px;
  margin-bottom: 2px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 7px 10px;
  border-radius: 6px;
  color: #cbd5e1;
  font-size: 12.5px;
  font-weight: 500;
  transition: all var(--transition-fast);
  cursor: pointer;
  position: relative;
  text-align: left;
  border: none;
  background: transparent;
  width: 100%;
}

.nav-item:hover {
  color: #ffffff;
  background: rgba(255, 255, 255, 0.09);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.06);
}

.nav-item.active {
  color: #ffffff;
  font-weight: 600;
}

.sidebar-active-pill {
  position: absolute;
  inset: 0;
  border-radius: 6px;
  background: linear-gradient(90deg, rgba(37, 99, 235, 0.28), rgba(37, 99, 235, 0.14));
  border-left: 3px solid var(--zth-blue-electric);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.08);
  z-index: 1;
}

.nav-item-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex: 1;
  min-width: 0;
}

.nav-pill {
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  background: var(--zth-blue-electric);
  color: #ffffff;
  padding: 1px 6px;
  border-radius: 10px;
  letter-spacing: 0.03em;
}

.sidebar-footer-card {
  margin: 10px;
  padding: 12px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.07);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.12);
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.footer-card-header {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: #ffffff;
}

.sidebar-footer-card p {
  font-size: 11px;
  line-height: 1.45;
  color: #94a3b8;
  margin: 0;
}

.footer-tag {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  font-weight: 600;
  color: #93c5fd;
}

/* ==========================================================================
   Header & Workflow Stepper
   ========================================================================== */
.app-main-frame {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.app-header {
  height: 52px;
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(20px) saturate(160%);
  -webkit-backdrop-filter: blur(20px) saturate(160%);
  border-bottom: 1px solid rgba(226, 232, 240, 0.65);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 20px;
  position: sticky;
  top: 0;
  z-index: 50;
  gap: 14px;
  box-shadow: 0 1px 0 rgba(255,255,255,0.85) inset, 0 2px 8px rgba(11, 27, 51, 0.04);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
}

.mobile-sidebar-toggle {
  display: none;
  color: var(--zth-navy-primary);
  padding: 4px;
  border-radius: 4px;
}

.mobile-sidebar-toggle:hover {
  background: var(--zth-blue-pale);
}

.breadcrumb-wrapper {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
  font-weight: 500;
}

.breadcrumb-root {
  color: var(--zth-blue-electric);
  font-weight: 700;
}

.breadcrumb-separator {
  color: #94a3b8;
}

.breadcrumb-current {
  color: #334155;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Workflow Stepper */
.workflow-stepper {
  display: flex;
  align-items: center;
  gap: 4px;
  background: rgba(255, 255, 255, 0.70);
  backdrop-filter: blur(16px) saturate(150%);
  -webkit-backdrop-filter: blur(16px) saturate(150%);
  padding: 3px 6px;
  border-radius: 20px;
  border: 1px solid rgba(226, 232, 240, 0.60);
  box-shadow: 0 2px 8px rgba(11, 27, 51, 0.04), inset 0 1px 0 rgba(255,255,255,0.8);
}

.stepper-item {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 16px;
  font-size: 12px;
  font-weight: 500;
  color: var(--zth-text-secondary);
  transition: color var(--transition-fast);
  position: relative;
  background: transparent;
  border: none;
  cursor: pointer;
}

.stepper-item:hover:not(.disabled) {
  color: var(--zth-navy-primary);
}

.stepper-item.disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.stepper-active-glider {
  position: absolute;
  inset: 0;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 16px;
  box-shadow: 0 1px 4px rgba(11, 27, 51, 0.10), inset 0 1px 0 rgba(255,255,255,1);
  border: 1px solid rgba(226, 232, 240, 0.70);
  z-index: 1;
}

.stepper-bubble {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #e2e8f0;
  color: #475569;
  font-size: 10px;
  font-weight: 700;
  position: relative;
  z-index: 2;
  transition: all var(--transition-fast);
}

.stepper-label {
  position: relative;
  z-index: 2;
}

.stepper-item.current {
  color: var(--zth-navy-primary);
  font-weight: 600;
}

.stepper-item.current .stepper-bubble {
  background: var(--zth-blue-electric);
  color: #ffffff;
}

.stepper-item.completed {
  color: #334155;
}

.stepper-item.completed .stepper-bubble {
  background: #dcfce7;
  color: #15803d;
}

.stepper-connector {
  width: 10px;
  height: 1px;
  background: #cbd5e1;
}

.stepper-connector.active {
  background: #94a3b8;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 8px;
}

.header-quick-upload {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 30px;
  padding: 0 10px;
  background: rgba(239, 246, 255, 0.85);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  color: var(--zth-blue-electric);
  border: 1px solid rgba(191, 219, 254, 0.70);
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
  box-shadow: 0 1px 3px rgba(37,99,235,0.06), inset 0 1px 0 rgba(255,255,255,0.6);
}

.header-quick-upload:hover {
  background: rgba(219, 234, 254, 0.95);
  border-color: #93c5fd;
  transform: translateY(-0.5px);
  box-shadow: 0 3px 10px rgba(37,99,235,0.10);
}

.header-settings-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 30px;
  padding: 0 10px;
  background: rgba(255, 255, 255, 0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(148, 163, 184, 0.28);
  border-radius: 6px;
  color: #475569;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-fast);
  box-shadow: 0 1px 3px rgba(11,27,51,0.04), inset 0 1px 0 rgba(255,255,255,0.75);
}

.header-settings-btn:hover {
  background: rgba(255, 255, 255, 0.92);
  border-color: rgba(59, 130, 246, 0.25);
  color: var(--zth-navy-primary);
  box-shadow: 0 3px 10px rgba(11,27,51,0.07), inset 0 1px 0 rgba(255,255,255,0.9);
}

.status-pill-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  margin-left: 2px;
}

/* ==========================================================================
   Screen 1: Dashboard & Upload Styles
   ========================================================================== */
.dashboard-page-container {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

/* Hero Section */
.dashboard-hero {
  background: rgba(255, 255, 255, 0.80);
  backdrop-filter: blur(22px) saturate(155%);
  -webkit-backdrop-filter: blur(22px) saturate(155%);
  border: 1px solid rgba(255, 255, 255, 0.68);
  border-radius: 18px;
  padding: 42px 48px;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.92),
    0 4px 24px -2px rgba(11, 27, 51, 0.05),
    0 14px 36px -6px rgba(11, 27, 51, 0.07);
  position: relative;
  overflow: hidden;
}

.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 15.5px;
  font-weight: 600;
  color: var(--zth-blue-electric);
  background: var(--zth-blue-pale);
  padding: 4px 10px;
  border-radius: 6px;
  margin-bottom: 14px;
}

.hero-title {
  font-size: clamp(22px, 2.5vw, 28px);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.2;
  color: var(--zth-navy-primary);
  margin: 0 0 14px;
  max-width: 780px;
}

.hero-subtitle {
  font-size: 14px;
  line-height: 1.6;
  color: var(--zth-text-secondary);
  max-width: 680px;
  margin: 0 0 20px;
}

.hero-pillars-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.pillar-chip {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--zth-text-main);
  background: rgba(255,255,255,0.85);
  border: 1px solid rgba(226,232,240,0.70);
  padding: 4px 12px;
  border-radius: 20px;
}

.pillar-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--zth-blue-electric);
}

/* Dashboard Workspace Grid */
.dashboard-workspace-grid {
  display: grid;
  grid-template-columns: minmax(0, 7.5fr) minmax(320px, 4.5fr);
  gap: 28px;
  align-items: start;
}

.dashboard-main-card {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(20px) saturate(155%);
  -webkit-backdrop-filter: blur(20px) saturate(155%);
  border: 1px solid rgba(255, 255, 255, 0.68);
  border-radius: 16px;
  padding: 34px 38px;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.92),
    0 4px 20px -2px rgba(11, 27, 51, 0.04),
    0 12px 32px -4px rgba(11, 27, 51, 0.06);
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.card-top-heading {
  margin-bottom: 4px;
}

.card-kicker {
  display: inline-block;
  font-size: 15.5px;
  font-weight: 600;
  color: var(--zth-blue-electric);
  margin-bottom: 4px;
}

.card-heading {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--zth-navy-primary);
  margin: 4px 0 4px;
}

.card-subtext {
  font-size: 13px;
  color: var(--zth-text-secondary);
  margin: 0;
  line-height: 1.55;
}

/* Upload Dropzone */
.dropzone-box {
  border: 2px dashed rgba(203, 213, 225, 0.70);
  border-radius: 12px;
  background: rgba(248, 250, 252, 0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  padding: 36px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  transition: all var(--transition-normal);
  cursor: pointer;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.80);
}

.dropzone-box:hover {
  border-color: rgba(37, 99, 235, 0.50);
  background: rgba(239, 246, 255, 0.85);
  box-shadow: 0 4px 16px rgba(37,99,235,0.06), inset 0 1px 0 rgba(255,255,255,0.90);
  transform: translateY(-1px);
}

.dropzone-box.is-dragging {
  border-color: var(--zth-blue-electric);
  background: rgba(239, 246, 255, 0.92);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12), inset 0 1px 0 rgba(255,255,255,0.95);
  transform: scale(1.01);
}

.dropzone-icon-circle {
  width: 58px;
  height: 58px;
  border-radius: 14px;
  background: #e0e7ff;
  color: var(--zth-blue-electric);
  display: grid;
  place-items: center;
  margin-bottom: 16px;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
}

.dropzone-title {
  font-size: 17px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 0 0 6px;
}

.dropzone-subtitle {
  font-size: 13px;
  color: var(--zth-text-secondary);
  margin: 0 0 14px;
}

.dropzone-browse-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  color: var(--zth-blue-electric);
  border: 1px solid #cbd5e1;
  padding: 14px 28px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
}

.dropzone-browse-btn:hover {
  border-color: var(--zth-blue-electric);
  background: var(--zth-blue-pale);
}

.dropzone-browse-btn input {
  display: none;
}

.dropzone-meta {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 11.5px;
  color: #64748b;
  margin-top: 12px;
}

.meta-bullet {
  font-weight: 800;
}

/* File Selected Card */
.file-selected-card {
  border: 1px solid rgba(191, 219, 254, 0.65);
  background: rgba(240, 247, 255, 0.80);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-radius: 12px;
  padding: 12px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  box-shadow: 0 2px 10px rgba(37,99,235,0.05), inset 0 1px 0 rgba(255,255,255,0.85);
}

.file-selected-main {
  display: flex;
  align-items: center;
  gap: 14px;
  min-width: 0;
}

.file-icon-box {
  width: 48px;
  height: 48px;
  background: #ffffff;
  border: 1px solid #bfdbfe;
  border-radius: 10px;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.file-info {
  display: flex;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}

.file-name-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.file-name {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-status-badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  font-weight: 600;
  color: var(--zth-success);
  background: #dcfce7;
  padding: 2px 6px;
  border-radius: 12px;
}

.file-size {
  font-size: 12px;
  color: var(--zth-text-secondary);
}

.file-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.file-action-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 12px;
  background: #ffffff;
  border: 1px solid #cbd5e1;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  transition: all var(--transition-fast);
}

.file-action-btn:hover {
  background: #f8fafc;
}

.file-action-btn input {
  display: none;
}

.file-action-btn.text-danger {
  color: var(--zth-critical);
}

.file-action-btn.text-danger:hover {
  background: #fef2f2;
  border-color: #fecaca;
}

/* Startup Context Form */
.startup-context-form {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.form-primary-grid {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.form-field.full-width {
  grid-column: 1 / -1;
}

.form-field label {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  display: flex;
  align-items: center;
  gap: 6px;
}

.required-star {
  color: var(--zth-critical);
}

.form-field input, .form-field select {
  width: 100%;
  padding: 8px 12px;
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 6px;
  font-size: 13px;
  color: var(--zth-text-main);
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.form-field input:focus, .form-field select:focus {
  border-color: var(--zth-blue-electric);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  outline: none;
}

.details-toggle-btn {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  background: #f8fafc;
  border: 1px solid var(--zth-border);
  border-radius: 6px;
  font-size: 13px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  transition: all var(--transition-fast);
}

.details-toggle-btn:hover {
  background: #f1f5f9;
}

.toggle-btn-left {
  display: flex;
  align-items: center;
  gap: 9px;
}

.optional-badge {
  font-size: 11px;
  padding: 2px 6px;
  border-radius: 10px;
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  font-weight: 600;
}

.optional-details-panel {
  padding: 18px;
  background: #f8fafc;
  border: 1px solid var(--zth-border);
  border-top: none;
  border-radius: 0 0 8px 8px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.details-help-text {
  font-size: 16.5px;
  color: var(--zth-text-secondary);
  margin: 0 0 6px;
  line-height: 1.5;
}

.details-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

/* Staged Loading Indicator */
.staged-loading-card {
  padding: 14px 16px;
  background: rgba(240, 247, 255, 0.82);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(191, 219, 254, 0.60);
  border-radius: 10px;
  display: flex;
  flex-direction: column;
  gap: 10px;
  box-shadow: 0 2px 12px rgba(37,99,235,0.05), inset 0 1px 0 rgba(255,255,255,0.75);
}

.staged-loading-header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.stage-step-tag {
  font-size: 14.5px;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: var(--zth-blue-electric);
}

.stage-current-label {
  font-size: 13px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 2px 0 0;
}

.stage-progress-bar-track {
  height: 6px;
  background: #dbeafe;
  border-radius: 6px;
  overflow: hidden;
}

.stage-progress-bar-fill {
  height: 100%;
  background: var(--zth-blue-electric);
  border-radius: 6px;
  transition: width 0.4s ease;
}

.stage-subtext {
  display: flex;
  justify-content: space-between;
  font-size: 15.5px;
  color: var(--zth-text-secondary);
}

/* Primary CTA Button */
.primary-analyze-btn {
  width: 100%;
  min-height: 50px;
  background: linear-gradient(135deg, #2563eb, #1d4ed8);
  color: #ffffff;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  box-shadow: var(--shadow-blue-glow), inset 0 1px 0 rgba(255,255,255,0.15);
  transition: all var(--transition-fast);
  border: 1px solid rgba(255,255,255,0.12);
}

.primary-analyze-btn:hover:not(:disabled) {
  background: linear-gradient(135deg, #1d4ed8, #1e40af);
  transform: translateY(-1.5px);
  box-shadow: 0 6px 20px rgba(37,99,235,0.30), inset 0 1px 0 rgba(255,255,255,0.15);
}

.primary-analyze-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

/* Dashboard Side Column Widgets */
.dashboard-side-col {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.side-widget-card {
  background: rgba(255, 255, 255, 0.80);
  backdrop-filter: blur(20px) saturate(150%);
  -webkit-backdrop-filter: blur(20px) saturate(150%);
  border: 1px solid rgba(255, 255, 255, 0.65);
  border-radius: 14px;
  padding: 24px 26px;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.90),
    0 4px 16px -2px rgba(11, 27, 51, 0.04),
    0 10px 24px -4px rgba(11, 27, 51, 0.05);
  display: flex;
  flex-direction: column;
  gap: 14px;
  transition: box-shadow var(--transition-fast);
}

.side-widget-card:hover {
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.95),
    0 6px 20px -3px rgba(11, 27, 51, 0.06),
    0 14px 32px -6px rgba(11, 27, 51, 0.07);
}

.widget-header {
  display: flex;
  align-items: center;
  gap: 10px;
}

.widget-header h4 {
  font-size: 14px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0;
}

.widget-text {
  font-size: 12.5px;
  color: var(--zth-text-secondary);
  line-height: 1.55;
  margin: 0;
}

.recent-report-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 6px;
}

.recent-startup-name {
  font-size: 14px;
  font-weight: 600;
  color: var(--zth-navy-primary);
}

.recent-score-chip {
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  padding: 2px 7px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 600;
}

.recent-report-desc {
  font-size: 16.5px;
  color: var(--zth-text-secondary);
  line-height: 1.5;
  margin: 0 0 12px;
}

.open-loop-indicator {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
  padding: 7px 10px;
  background: rgba(254, 242, 242, 0.82);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(254, 202, 202, 0.65);
  border-radius: 8px;
  margin-bottom: 10px;
  flex-wrap: wrap;
}

.open-loop-count {
  font-weight: 700;
  color: var(--zth-critical);
}

.open-loop-text {
  color: #64748b;
  font-size: 14.5px;
}

.view-report-link-btn, .sample-report-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  width: 100%;
  padding: 10px 14px;
  border-radius: 7px;
  font-size: 13px;
  font-weight: 600;
  transition: all var(--transition-fast);
}

.view-report-link-btn {
  background: var(--zth-navy-primary);
  color: #ffffff;
}

.view-report-link-btn:hover {
  background: var(--zth-navy-deep);
}

.sample-report-btn {
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  border: 1px solid #bfdbfe;
}

.sample-report-btn:hover {
  background: #dbeafe;
}

.how-it-works-steps {
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.how-it-works-steps li {
  font-size: 12.5px;
  line-height: 1.5;
  color: var(--zth-text-secondary);
}

.how-it-works-steps strong {
  display: block;
  color: var(--zth-navy-primary);
  margin-bottom: 2px;
}

/* ==========================================================================
   Screen 2: Pitch Deck Evaluation Styles
   ========================================================================== */
.evaluation-page-container {
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.report-action-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 16px;
}

.report-kicker {
  display: inline-block;
  font-size: 15.5px;
  font-weight: 600;
  color: var(--zth-blue-electric);
  margin-bottom: 2px;
}

.report-page-title {
  font-size: clamp(19px, 2.2vw, 24px);
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 4px 0 0;
}

.report-topbar-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.report-export-btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 10px 16px;
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 8px;
  font-size: 12.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  transition: all var(--transition-fast);
}

.report-export-btn:hover {
  background: #f8fafc;
  border-color: #cbd5e1;
}

.report-practice-cta-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  background: var(--zth-blue-electric);
  color: #ffffff;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  box-shadow: var(--shadow-blue-glow);
  transition: all var(--transition-fast);
}

.report-practice-cta-btn:hover {
  background: #1d4ed8;
  transform: translateY(-1px);
}

.report-practice-cta-btn.large {
  padding: 13px 24px;
  font-size: 18.5px;
}

/* Readiness Score Card */
.readiness-score-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(22px) saturate(160%);
  -webkit-backdrop-filter: blur(22px) saturate(160%);
  border: 1px solid rgba(255, 255, 255, 0.72);
  border-radius: 16px;
  padding: 34px 40px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.95),
    0 4px 20px -2px rgba(11, 27, 51, 0.04),
    0 14px 36px -6px rgba(11, 27, 51, 0.07);
}

.score-card-left {
  display: flex;
  flex-direction: column;
  gap: 10px;
  flex: 1;
}

.score-meta-badges {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.badge-pill {
  font-size: 11px;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: 20px;
}

.badge-live {
  background: #dcfce7;
  color: #166534;
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.badge-sample {
  background: #fef3c7;
  color: #92400e;
}

.badge-stage, .badge-industry {
  background: #f1f5f9;
  color: var(--zth-navy-primary);
}

.readiness-startup-title {
  font-size: 20px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 4px 0 0;
  letter-spacing: -0.015em;
}

.readiness-score-note {
  font-size: 13px;
  color: var(--zth-text-secondary);
  line-height: 1.55;
  margin: 0;
  max-width: 780px;
}

.score-disclaimer {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 15.5px;
  color: #64748b;
  line-height: 1.5;
  margin-top: 6px;
}

.score-card-right {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  flex-shrink: 0;
}

.circular-meter {
  position: relative;
  width: 128px;
  height: 128px;
}

.meter-svg {
  transform: rotate(-90deg);
}

.meter-bg {
  fill: none;
  stroke: #e2e8f0;
}

.meter-fill {
  fill: none;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.8s ease;
}

.meter-label {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.meter-number {
  font-size: 28px;
  font-weight: 800;
  line-height: 1;
}

.meter-sub {
  font-size: 15.5px;
  font-weight: 600;
  color: #94a3b8;
}

.meter-caption {
  font-size: 15.5px;
  font-weight: 700;
  color: #64748b;
  letter-spacing: 0.04em;
}

/* Highest Weakness Spotlight */
.highest-weakness-spotlight {
  background: rgba(255, 251, 250, 0.85);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border: 1px solid rgba(254, 202, 202, 0.60);
  border-left: 4px solid var(--zth-critical);
  border-radius: 12px;
  padding: 18px 22px;
  box-shadow: 0 4px 16px rgba(185, 28, 28, 0.04);
}

.spotlight-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16px;
  gap: 16px;
}

.spotlight-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 15.5px;
  font-weight: 700;
  color: var(--zth-critical);
  background: #fef2f2;
  border: 1px solid #fecaca;
  padding: 3px 8px;
  border-radius: 6px;
  margin-bottom: 8px;
}

.spotlight-issue-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 0;
  letter-spacing: -0.01em;
}

.spotlight-slide-tag {
  font-size: 15.5px;
  font-weight: 700;
  color: #64748b;
  background: #ffffff;
  border: 1px solid #cbd5e1;
  padding: 4px 10px;
  border-radius: 6px;
  white-space: nowrap;
}

.spotlight-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24px;
}

.spotlight-label {
  display: block;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.10em;
  color: #64748b;
  margin-bottom: 4px;
}

.spotlight-col p {
  font-size: 13px;
  line-height: 1.55;
  color: var(--zth-text-main);
  margin: 0;
}

.recommendation-col {
  background: #ffffff;
  padding: 16px;
  border-radius: 8px;
  border: 1px solid #fee2e2;
}

/* Category Cards Grid */
.report-section {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.section-header-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.section-title {
  font-size: 16px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 0 0 4px;
}

.section-subtitle {
  font-size: 13px;
  color: var(--zth-text-secondary);
  margin: 0;
}

.section-count-tag {
  font-size: 11px;
  font-weight: 600;
  color: #64748b;
  background: #e2e8f0;
  padding: 2px 8px;
  border-radius: 20px;
}

.rubric-group {
  margin-bottom: 22px;
}

.rubric-group:last-child {
  margin-bottom: 0;
}

.rubric-group-title {
  font-size: 16.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 0 0 10px 2px;
  letter-spacing: -0.01em;
}

.category-cards-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.category-card {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(18px) saturate(150%);
  -webkit-backdrop-filter: blur(18px) saturate(150%);
  border: 1px solid rgba(226, 232, 240, 0.65);
  border-radius: 12px;
  overflow: hidden;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.90),
    0 2px 8px -2px rgba(11, 27, 51, 0.04);
  transition: all var(--transition-fast);
}

.category-card:hover {
  border-color: rgba(147, 197, 253, 0.70);
  transform: translateY(-1px);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.95),
    0 8px 22px -4px rgba(37, 99, 235, 0.09);
}

.category-card.is-open {
  border-color: #60a5fa;
  box-shadow: 
    inset 0 1px 0 0 rgba(255, 255, 255, 1),
    0 8px 24px -4px rgba(37, 99, 235, 0.12);
}

.category-card-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  background: #ffffff;
  text-align: left;
}

.cat-header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.cat-icon-box {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.cat-name {
  font-size: 18.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
}

.cat-header-right {
  display: flex;
  align-items: center;
  gap: 10px;
}

.cat-score-badge {
  font-size: 11px;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: 20px;
}

.score-pill-high {
  background: #dcfce7;
  color: #166534;
}

.score-pill-med {
  background: #eff6ff;
  color: #1e40af;
}

.score-pill-low {
  background: #fef2f2;
  color: #991b1b;
}

.cat-expand-arrow {
  color: #94a3b8;
}

.cat-bar-track {
  height: 4px;
  background: #f1f5f9;
  width: 100%;
}

.cat-bar-fill {
  height: 100%;
}

.cat-bar-fill.score-pill-high {
  background: #15803d;
}

.cat-bar-fill.score-pill-med {
  background: #2563eb;
}

.cat-bar-fill.score-pill-low {
  background: #b91c1c;
}

.category-card-body {
  padding: 18px 20px;
  background: #f8fafc;
  border-top: 1px solid var(--zth-border);
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.cat-section-label {
  font-size: 14.5px;
  font-weight: 600;
  color: #64748b;
  margin-bottom: 4px;
  display: block;
}

.cat-reason-text {
  font-size: 16.5px;
  line-height: 1.6;
  color: var(--zth-text-main);
  margin: 0;
}

.cat-evidence-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 15.5px;
  font-weight: 600;
  color: var(--zth-blue-electric);
  background: #ffffff;
  padding: 5px 10px;
  border-radius: 6px;
  border: 1px solid #bfdbfe;
  align-self: flex-start;
}

.cat-evidence-tag.muted {
  color: #64748b;
  border-color: #cbd5e1;
}

/* Evidence Panel */
.evidence-panel-wrapper {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 12px;
  padding: 24px 28px;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.evidence-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-header-left {
  display: flex;
  align-items: center;
  gap: 10px;
}

.evidence-title {
  font-size: 21px;
  font-weight: 800;
  color: var(--zth-navy-primary);
  margin: 0;
}

.evidence-count-pill {
  font-size: 15.5px;
  font-weight: 700;
  color: var(--zth-blue-electric);
  background: var(--zth-blue-pale);
  padding: 3px 9px;
  border-radius: 14px;
}

.evidence-toggle-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 16.5px;
  font-weight: 700;
  color: var(--zth-blue-electric);
}

.source-disclaimer-row {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.source-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 15.5px;
  font-weight: 600;
  padding: 5px 12px;
  border-radius: 6px;
}

.source-badge.badge-active {
  background: #f0fdf4;
  color: #166534;
  border: 1px solid #bbf7d0;
}

.source-badge.badge-inactive {
  background: #f8fafc;
  color: #64748b;
  border: 1px solid #e2e8f0;
}

.evidence-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 10px;
}

.evidence-card {
  padding: 14px 16px;
  border-radius: 8px;
  background: #f8fafc;
  border: 1px solid var(--zth-border);
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.evidence-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.evidence-type-pill {
  font-size: 14.5px;
  font-weight: 800;
  letter-spacing: 0.1em;
  padding: 2px 7px;
  border-radius: 4px;
}

.evidence-type-pill.strength {
  background: #dcfce7;
  color: #166534;
}

.evidence-type-pill.improvement {
  background: #fee2e2;
  color: #991b1b;
}

.evidence-slide-pill {
  font-size: 14.5px;
  font-weight: 700;
  color: #64748b;
}

.evidence-card-title {
  font-size: 16.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 0;
}

.evidence-card-sub {
  font-size: 15.5px;
  color: var(--zth-text-secondary);
  line-height: 1.5;
  margin: 0;
}

/* Priority Action List */
.priority-action-section {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.action-section-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.action-progress-chip {
  font-size: 15.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  background: #e2e8f0;
  padding: 4px 12px;
  border-radius: 20px;
}

.actions-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.action-card {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 10px;
  padding: 20px 22px;
  display: flex;
  flex-direction: column;
  gap: 14px;
  transition: all var(--transition-fast);
}

.action-card:hover {
  box-shadow: var(--shadow-sm);
}

.action-card.is-completed {
  opacity: 0.7;
  background: #f8fafc;
}

.action-card.high {
  border-left: 4px solid var(--zth-critical);
}

.action-card.medium {
  border-left: 4px solid var(--zth-warning);
}

.action-card.low {
  border-left: 4px solid var(--zth-blue-electric);
}

.action-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
}

.action-header-left {
  display: flex;
  align-items: center;
  gap: 12px;
}

.action-checkbox {
  display: grid;
  place-items: center;
  cursor: pointer;
  padding: 2px;
}

.action-titles {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.priority-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 14.5px;
  font-weight: 800;
  letter-spacing: 0.08em;
  padding: 3px 8px;
  border-radius: 6px;
}

.priority-high {
  background: #fee2e2;
  color: var(--zth-critical);
}

.priority-med {
  background: #fef3c7;
  color: var(--zth-warning);
}

.priority-low {
  background: #e0e7ff;
  color: var(--zth-blue-electric);
}

.action-issue-text {
  font-size: 18.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
}

.action-slide-tag {
  font-size: 15.5px;
  font-weight: 700;
  color: #64748b;
  background: #f1f5f9;
  padding: 3px 8px;
  border-radius: 6px;
}

.action-card-body {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  padding-left: 32px;
}

.action-label {
  font-size: 14.5px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: #64748b;
  margin-bottom: 4px;
  display: block;
}

.action-why-box p {
  font-size: 16.5px;
  line-height: 1.55;
  color: var(--zth-text-secondary);
  margin: 0;
}

.action-rec-box {
  display: flex;
  gap: 10px;
  align-items: flex-start;
  background: #f0f7ff;
  border: 1px solid #dbeafe;
  border-radius: 8px;
  padding: 12px 14px;
}

.rec-content p {
  font-size: 16.5px;
  line-height: 1.55;
  color: #1e3a8a;
  margin: 0;
}

/* Missing Info & Limitations Blocks */
.meta-toggle-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 13px 18px;
  background: #f8fafc;
  border: 1px solid var(--zth-border);
  border-radius: 9px;
  font-size: 16.5px;
  font-weight: 600;
  color: var(--zth-text-secondary);
  transition: all var(--transition-fast);
  cursor: pointer;
  margin-bottom: 14px;
}

.meta-toggle-btn:hover {
  background: var(--zth-blue-pale);
  color: var(--zth-navy-primary);
  border-color: #bfdbfe;
}

.missing-info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.info-block {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 10px;
  padding: 20px 24px;
}

.info-block h4 {
  font-size: 18.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 0 0 10px;
}

.info-bullets {
  margin: 0;
  padding-left: 20px;
  font-size: 16.5px;
  line-height: 1.7;
  color: var(--zth-text-secondary);
}

/* Bottom Floating CTA Banner */
.report-bottom-cta-banner {
  background: var(--zth-navy-primary);
  color: #ffffff;
  border-radius: 14px;
  padding: 28px 36px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  box-shadow: var(--shadow-lg);
}

.cta-banner-text {
  display: flex;
  align-items: center;
  gap: 18px;
}

.cta-banner-text h4 {
  font-size: 23px;
  font-weight: 800;
  margin: 0 0 4px;
  color: #ffffff;
}

.cta-banner-text p {
  font-size: 17.5px;
  color: #cbd5e1;
  margin: 0;
  line-height: 1.5;
}

/* ==========================================================================
   Screen 3: Investor Pitch Simulation Styles
   ========================================================================== */
.practice-page-container {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.practice-page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.practice-kicker {
  display: inline-block;
  font-size: 15.5px;
  font-weight: 600;
  color: var(--zth-blue-electric);
  margin-bottom: 2px;
}

.practice-page-title {
  font-size: clamp(19px, 2.2vw, 24px);
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 4px 0 4px;
}

.practice-subtitle {
  font-size: 13px;
  color: var(--zth-text-secondary);
  margin: 0;
}

.reset-practice-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 16.5px;
  font-weight: 700;
  color: #64748b;
  padding: 8px 14px;
  border-radius: 6px;
  border: 1px solid #cbd5e1;
  background: #ffffff;
  transition: all var(--transition-fast);
}

.reset-practice-btn:hover {
  background: #f8fafc;
  color: var(--zth-navy-primary);
}

/* Persona Selection Grid */
.persona-picker-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.picker-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0 0 2px;
}

.picker-sub {
  font-size: 12.5px;
  color: var(--zth-text-secondary);
  margin: 0;
}

.persona-cards-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.persona-card {
  background: rgba(255, 255, 255, 0.75);
  backdrop-filter: blur(14px) saturate(140%);
  -webkit-backdrop-filter: blur(14px) saturate(140%);
  border: 1px solid rgba(226, 232, 240, 0.60);
  border-radius: 12px;
  padding: 14px 16px;
  cursor: pointer;
  transition: all var(--transition-fast);
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.85), 0 2px 8px rgba(11,27,51,0.04);
}

.persona-card-active-outline {
  position: absolute;
  inset: -1.5px;
  border: 2px solid var(--zth-blue-electric);
  border-radius: 12px;
  pointer-events: none;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  z-index: 1;
}

.persona-card:hover {
  border-color: #93c5fd;
  box-shadow: var(--shadow-sm);
}

.persona-card.is-selected {
  background: #f0f7ff;
}

.persona-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.persona-icon-box {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  display: grid;
  place-items: center;
}

.persona-selected-badge {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 14.5px;
  font-weight: 800;
  background: var(--zth-blue-electric);
  color: #ffffff;
  padding: 3px 9px;
  border-radius: 12px;
}

.persona-title {
  font-size: 14px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0 0 2px;
}

.persona-sub {
  font-size: 15.5px;
  color: var(--zth-blue-bright);
  font-weight: 600;
}

.persona-focus {
  font-size: 16.5px;
  line-height: 1.55;
  color: var(--zth-text-secondary);
  margin: 0;
}

/* Two-Column Simulation Workspace Grid */
.simulation-layout-grid {
  display: grid;
  grid-template-columns: minmax(0, 8fr) minmax(320px, 4fr);
  gap: 24px;
  align-items: start;
}

.simulation-main-col {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

/* Current Question Card */
.current-question-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(226, 232, 240, 0.95);
  border-left: 5px solid var(--zth-blue-electric);
  border-radius: 14px;
  padding: 26px 30px;
  box-shadow: 
    inset 0 1px 0 0 rgba(255, 255, 255, 1),
    0 4px 20px -2px rgba(11, 27, 51, 0.04),
    0 12px 32px -4px rgba(11, 27, 51, 0.06);
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.question-card-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.question-pill-tag {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  font-size: 15.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
}

.question-live-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #15803d;
  display: inline-block;
}

.question-topic-pill {
  font-size: 15.5px;
  font-weight: 700;
  color: var(--zth-blue-electric);
  background: var(--zth-blue-pale);
  padding: 3px 9px;
  border-radius: 6px;
}

.question-body {
  font-size: 21px;
  line-height: 1.65;
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 0;
}

.question-empty-state {
  font-size: 18.5px;
  color: var(--zth-text-secondary);
}

.question-rationale-box {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  font-size: 16.5px;
  line-height: 1.5;
  color: #475569;
  background: #f8fafc;
  padding: 10px 14px;
  border-radius: 8px;
  border: 1px solid #e2e8f0;
}

.question-rationale-box.prominent {
  background: var(--zth-blue-pale);
  border: 1px solid #bfdbfe;
  padding: 13px 16px;
  border-radius: 10px;
  gap: 12px;
}

.rationale-heading {
  display: block;
  font-size: 16.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin-bottom: 3px;
}

.rationale-text {
  font-size: 16.5px;
  line-height: 1.55;
  color: #334155;
}

.generate-question-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 18px;
  background: #ffffff;
  color: var(--zth-navy-primary);
  border: 1px solid #cbd5e1;
  border-radius: 7px;
  font-size: 16.5px;
  font-weight: 700;
  transition: all var(--transition-fast);
}

.generate-question-btn:hover {
  background: #f8fafc;
  border-color: #94a3b8;
}

/* Answer Input Box */
.answer-input-section {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 12px;
  padding: 22px 26px;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.answer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.answer-prompt-chips {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
  padding: 4px 0 2px;
}

.prompt-chips-label {
  font-size: 15.5px;
  font-weight: 600;
  color: var(--zth-text-secondary);
}

.prompt-chip {
  font-size: 15.5px;
  font-weight: 600;
  padding: 4px 11px;
  border-radius: 16px;
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  border: 1px solid #bfdbfe;
  cursor: pointer;
  transition: all var(--transition-fast);
  white-space: nowrap;
}

.prompt-chip:hover:not(:disabled) {
  background: #dbeafe;
  border-color: var(--zth-blue-electric);
}

.prompt-chip:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.answer-title {
  font-size: 17.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
}

.answer-meta {
  display: flex;
  align-items: center;
  gap: 12px;
}

.word-count-chip {
  font-size: 15.5px;
  font-weight: 700;
  color: #64748b;
}

.keyboard-hint {
  font-size: 14.5px;
  color: #94a3b8;
}

.answer-textarea {
  width: 100%;
  padding: 14px;
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 8px;
  font-size: 18.5px;
  line-height: 1.65;
  color: var(--zth-text-main);
  resize: vertical;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
}

.answer-textarea:focus {
  border-color: var(--zth-blue-electric);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
  outline: none;
}

.answer-actions-bar {
  display: flex;
  justify-content: flex-end;
}

.submit-answer-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 11px 22px;
  background: var(--zth-navy-primary);
  color: #ffffff;
  border-radius: 8px;
  font-size: 17.5px;
  font-weight: 700;
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-fast);
}

.submit-answer-btn:hover:not(:disabled) {
  background: var(--zth-navy-deep);
}

.submit-answer-btn:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

/* AI Typing Indicator */
.ai-typing-indicator-card {
  padding: 14px 18px;
  background: var(--zth-blue-pale);
  border: 1px solid #bfdbfe;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 16.5px;
  font-weight: 600;
  color: var(--zth-blue-electric);
}

.typing-dots {
  display: flex;
  gap: 4px;
}

.typing-dots span {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--zth-blue-electric);
  animation: typingPulse 1.4s infinite ease-in-out both;
}

.typing-dots span:nth-child(1) { animation-delay: -0.32s; }
.typing-dots span:nth-child(2) { animation-delay: -0.16s; }

@keyframes typingPulse {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1.1); opacity: 1; }
}

/* Feedback Critique Card */
.feedback-critique-card {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(226, 232, 240, 0.95);
  border-radius: 14px;
  overflow: hidden;
  box-shadow: 
    inset 0 1px 0 0 rgba(255, 255, 255, 1),
    0 8px 28px -4px rgba(11, 27, 51, 0.08);
  display: flex;
  flex-direction: column;
}

.feedback-card-top {
  display: flex;
  align-items: center;
  gap: 20px;
  background: #f0f7ff;
  padding: 22px 26px;
  border-bottom: 1px solid #dbeafe;
}

.feedback-score-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #ffffff;
  padding: 10px 18px;
  border-radius: 8px;
  border: 1px solid #bfdbfe;
  flex-shrink: 0;
}

.score-badge-sub {
  font-size: 14.5px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: #64748b;
}

.score-badge-main {
  font-size: 38px;
  font-weight: 800;
  color: var(--zth-navy-primary);
  line-height: 1;
  margin-top: 2px;
}

.score-badge-main small {
  font-size: 17.5px;
  color: #94a3b8;
}

.feedback-verdict-text h4 {
  font-size: 21px;
  font-weight: 800;
  color: var(--zth-navy-primary);
  margin: 0 0 4px;
}

.feedback-verdict-text p {
  font-size: 17.5px;
  color: var(--zth-text-secondary);
  line-height: 1.6;
  margin: 0;
}

.critique-columns-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
  padding: 22px 26px;
}

.critique-column {
  padding: 16px 18px;
  border-radius: 8px;
}

.critique-column.positive {
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
}

.critique-column.gaps {
  background: #fffbfa;
  border: 1px solid #fed7aa;
}

.critique-column-header {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 8px;
}

.critique-column-header h5 {
  font-size: 16.5px;
  font-weight: 800;
  letter-spacing: 0.04em;
  margin: 0;
  color: var(--zth-navy-primary);
}

.critique-column ul {
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 16.5px;
  line-height: 1.5;
  color: #334155;
}

.critique-example-box {
  margin: 0 26px 18px;
  padding: 16px 18px;
  background: #f8fafc;
  border: 1px solid var(--zth-border);
  border-radius: 8px;
}

.example-box-header {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 15.5px;
  font-weight: 700;
  color: var(--zth-blue-electric);
  margin-bottom: 6px;
}

.critique-example-box p {
  font-size: 16.5px;
  line-height: 1.65;
  color: var(--zth-text-main);
  margin: 0;
}

.critique-followup-box {
  margin: 0 26px 22px;
  padding: 14px 18px;
  background: var(--zth-blue-pale);
  border-radius: 8px;
  border: 1px solid #dbeafe;
}

.followup-header {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 15.5px;
  font-weight: 700;
  color: var(--zth-blue-electric);
  margin-bottom: 4px;
}

.critique-followup-box p {
  font-size: 17.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0;
}

/* History Stream */
.simulation-history-section {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 10px;
}

.history-title {
  font-size: 18.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 0;
}

.history-cards-stream {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.history-card {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 8px;
  padding: 14px 18px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.history-q-row, .history-a-row {
  display: flex;
  gap: 8px;
  font-size: 16.5px;
  line-height: 1.5;
}

.history-q-tag {
  font-weight: 800;
  color: var(--zth-blue-electric);
}

.history-a-tag {
  font-weight: 700;
  color: var(--zth-navy-primary);
}

.history-q-text {
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0;
}

.history-a-text {
  color: var(--zth-text-secondary);
  margin: 0;
}

.history-score-chip {
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  font-size: 14.5px;
  font-weight: 700;
  background: #f1f5f9;
  padding: 3px 8px;
  border-radius: 4px;
  margin-top: 4px;
}

.score-trend-up {
  color: var(--zth-success);
  font-weight: 700;
  margin-left: 8px;
  display: inline-flex;
  align-items: center;
}

.score-trend-down {
  color: var(--zth-text-secondary);
  font-weight: 600;
  margin-left: 8px;
}

/* Simulation Context Column */
.simulation-context-col {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.context-card {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 12px;
  padding: 20px 22px;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.context-card-header {
  display: flex;
  align-items: center;
  gap: 8px;
}

.context-label {
  font-size: 14.5px;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: #64748b;
}

.context-card-title {
  font-size: 19.5px;
  font-weight: 800;
  color: var(--zth-navy-primary);
  margin: 0;
}

.context-card-desc {
  font-size: 16.5px;
  line-height: 1.55;
  color: var(--zth-text-secondary);
  margin: 0;
}

.weakness-chips-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 4px;
}

.weakness-item-mini {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15.5px;
  color: var(--zth-text-main);
  background: #f8fafc;
  padding: 8px 10px;
  border-radius: 6px;
  border: 1px solid #e2e8f0;
}

.mini-priority-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  flex-shrink: 0;
}

.mini-priority-dot.high { background: var(--zth-critical); }
.mini-priority-dot.medium { background: var(--zth-warning); }
.mini-priority-dot.low { background: var(--zth-blue-electric); }

.prep-tips-list {
  margin: 0;
  padding-left: 18px;
  font-size: 16.5px;
  line-height: 1.6;
  color: var(--zth-text-secondary);
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.prep-tips-list strong {
  color: var(--zth-navy-primary);
}

.practice-footer-disclaimer {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 12px;
  color: #64748b;
  line-height: 1.5;
  padding: 10px 14px;
  background: rgba(248, 250, 252, 0.75);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 8px;
  border: 1px solid rgba(226,232,240,0.55);
}

/* ==========================================================================
   Modals & Banners
   ========================================================================== */
.modal-overlay {
  position: fixed;
  inset: 0;
  background: rgba(11, 27, 51, 0.50);
  backdrop-filter: blur(12px) saturate(140%);
  -webkit-backdrop-filter: blur(12px) saturate(140%);
  display: grid;
  place-items: center;
  z-index: 100;
  padding: 16px;
}

.modal-content {
  background: rgba(255, 255, 255, 0.97);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 14px;
  border: 1px solid rgba(255, 255, 255, 0.80);
  width: 100%;
  max-width: 520px;
  max-height: 90vh;
  overflow-y: auto;
  box-shadow: 0 24px 48px -8px rgba(11, 27, 51, 0.16), 0 0 0 1px rgba(11, 27, 51, 0.04), inset 0 1px 0 rgba(255,255,255,1);
  padding: 24px 26px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.modal-title {
  font-size: 17px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0 0 3px;
  letter-spacing: -0.01em;
}

.modal-subtitle {
  font-size: 12.5px;
  color: var(--zth-text-secondary);
  margin: 0;
  line-height: 1.4;
}

.modal-close-btn {
  color: #64748b;
  padding: 4px;
  border-radius: 5px;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.modal-close-btn:hover {
  background: #f1f5f9;
  color: var(--zth-navy-primary);
}

.modal-body-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.settings-callout {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 10px 12px;
  border: 1px solid #bfdbfe;
  background: #eff6ff;
  border-radius: 6px;
  font-size: 11.5px;
  line-height: 1.45;
  color: #1e3a8a;
}

.provider-field {
  display: flex;
  flex-direction: column;
  gap: 4px;
  font-size: 11.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.03em;
  color: var(--zth-navy-primary);
}

.provider-field input, .provider-field select {
  width: 100%;
  height: 34px;
  padding: 0 10px;
  border: 1px solid var(--zth-border);
  border-radius: 6px;
  font-size: 12.5px;
  background: #ffffff;
  color: var(--zth-text-main);
  text-transform: none;
  font-weight: 400;
}

.provider-field input:focus, .provider-field select:focus {
  border-color: var(--zth-blue-electric);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  outline: none;
}

.provider-field small {
  font-size: 11px;
  font-weight: 400;
  color: var(--zth-text-secondary);
  text-transform: none;
}

.preset-pills-container {
  display: flex;
  flex-direction: column;
  gap: 6px;
  padding: 8px 10px;
  background: var(--zth-surface-subtle);
  border: 1px solid var(--zth-border-subtle);
  border-radius: var(--zth-radius-sm);
  margin-bottom: 2px;
}

.preset-pills-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 600;
  color: var(--zth-text-secondary);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.preset-pills-group {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.preset-pill-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11px;
  font-weight: 500;
  padding: 3px 8px;
  border-radius: 5px;
  border: 1px solid var(--zth-border);
  background: #ffffff;
  color: var(--zth-navy-primary);
  cursor: pointer;
  transition: all var(--zth-transition-fast);
}

.preset-pill-btn:hover {
  background: var(--zth-blue-pale);
  border-color: #93c5fd;
  color: var(--zth-blue-electric);
}

.preset-pill-btn.active {
  background: var(--zth-blue-pale);
  border-color: var(--zth-blue-electric);
  color: var(--zth-blue-electric);
  font-weight: 600;
}

.preset-pill-tag {
  font-size: 9.5px;
  font-weight: 700;
  padding: 1px 4px;
  border-radius: 3px;
  background: #f1f5f9;
  color: var(--zth-navy-primary);
  text-transform: uppercase;
}

.preset-pill-btn.active .preset-pill-tag {
  background: #dbeafe;
  color: var(--zth-blue-electric);
}

.preset-pill-title {
  white-space: nowrap;
}

.provider-warning-box {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 8px 10px;
  border-radius: 6px;
  background: #fffbeb;
  border: 1px solid #fde68a;
  color: #92400e;
  font-size: 11.5px;
  line-height: 1.45;
}

.provider-warning-box strong {
  font-weight: 600;
}

.provider-warning-box code {
  background: rgba(0, 0, 0, 0.06);
  padding: 1px 4px;
  border-radius: 3px;
  font-family: monospace;
  font-size: 11px;
}

.provider-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-top: 4px;
}

.primary-button, .secondary-button {
  height: 34px;
  padding: 0 12px;
  border-radius: 6px;
  transition: all var(--transition-fast);
  font-size: 12.5px;
  font-weight: 600;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.primary-button {
  background: var(--zth-blue-electric);
  color: #ffffff;
  border: none;
}

.primary-button:hover:not(:disabled) {
  background: var(--zth-blue-hover);
}

.secondary-button {
  background: #f8fafc;
  color: var(--zth-text-secondary);
  border: 1px solid var(--zth-border);
}

.secondary-button:hover:not(:disabled) {
  background: #f1f5f9;
  color: var(--zth-navy-primary);
}

/* ==========================================================================
   Responsive Breakpoints & Reduced Motion
   ========================================================================== */
@media (max-width: 1024px) {
  .dashboard-workspace-grid {
    grid-template-columns: 1fr;
  }
  .simulation-layout-grid {
    grid-template-columns: 1fr;
  }
  .persona-cards-grid {
    grid-template-columns: 1fr;
  }
  .category-cards-grid {
    grid-template-columns: 1fr;
  }
  .evidence-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  .app-sidebar {
    position: fixed;
    left: -260px;
    top: 0;
    bottom: 0;
    transition: left var(--transition-normal);
  }

  .app-root.sidebar-is-collapsed .app-sidebar {
    left: 0;
  }

  .mobile-sidebar-toggle {
    display: grid;
    place-items: center;
  }

  .app-header {
    padding: 0 16px;
  }

  .breadcrumb-wrapper {
    display: none;
  }

  .app-content-body {
    padding: 20px 16px 40px;
  }

  .dashboard-hero {
    padding: 28px 20px;
  }

  .hero-title {
    font-size: 32px;
  }

  .dashboard-main-card {
    padding: 22px 18px;
  }

  .form-primary-grid, .details-grid, .spotlight-grid, .action-card-body, .critique-columns-grid, .missing-info-grid {
    grid-template-columns: 1fr;
  }

  .readiness-score-card {
    flex-direction: column-reverse;
    padding: 24px 20px;
    align-items: flex-start;
  }

  .report-bottom-cta-banner {
    flex-direction: column;
    align-items: flex-start;
    padding: 22px 20px;
  }

  .provider-actions {
    grid-template-columns: 1fr;
  }
}

/* ==========================================================================
   Hero & Interactive Demo Elements
   ========================================================================== */
.hero-top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.hero-badge-pill {
  font-size: 14.5px;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: #2563eb;
  background: rgba(37, 99, 235, 0.08);
  border: 1px solid rgba(37, 99, 235, 0.2);
  padding: 3px 10px;
  border-radius: 20px;
}

.hero-cta-group {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8px;
  margin: 22px 0 24px;
}

.hero-demo-pill-btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, #10284c 0%, #1e3a8a 100%);
  color: #ffffff;
  padding: 13px 22px;
  border-radius: 10px;
  font-size: 17.5px;
  font-weight: 700;
  box-shadow: 0 4px 14px rgba(16, 40, 76, 0.25);
  border: 1px solid rgba(255, 255, 255, 0.15);
  transition: all var(--transition-fast);
}

.hero-demo-pill-btn:hover {
  box-shadow: 0 6px 20px rgba(37, 99, 235, 0.35);
  transform: translateY(-1px);
}

.hero-demo-subtext {
  font-size: 15.5px;
  color: var(--zth-text-secondary);
  font-weight: 500;
}

/* ==========================================================================
   Stage Pills & Quick Industry Chips
   ========================================================================== */
.stage-pill-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.stage-pill-btn {
  padding: 12px 20px;
  font-size: 19.5px;
  font-weight: 700;
  color: var(--zth-text-secondary);
  background: #f8fafc;
  border: 1px solid var(--zth-border);
  border-radius: 8px;
  transition: all var(--transition-fast);
}

.stage-pill-btn:hover {
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  border-color: #bfdbfe;
}

.stage-pill-btn.active {
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  border-color: var(--zth-blue-electric);
  font-weight: 700;
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.12);
}

.industry-quick-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.industry-chip-btn {
  font-size: 17.5px;
  font-weight: 600;
  padding: 7px 15px;
  border-radius: 18px;
  background: #f1f5f9;
  color: var(--zth-text-secondary);
  border: 1px solid #e2e8f0;
  transition: all var(--transition-fast);
}

.industry-chip-btn:hover {
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  border-color: #bfdbfe;
}

.industry-chip-btn.active {
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  border-color: var(--zth-blue-electric);
  font-weight: 700;
}

/* Dropzone Quick Sample Alternative */
.dropzone-demo-alternative {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 14px;
  font-size: 15.5px;
  color: var(--zth-text-secondary);
}

.dropzone-sample-quick-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 12px;
  background: var(--zth-blue-pale);
  border: 1px dashed #93c5fd;
  border-radius: 6px;
  font-size: 15.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  transition: all var(--transition-fast);
}

.dropzone-sample-quick-btn:hover {
  background: #dbeafe;
  border-color: var(--zth-blue-electric);
  color: var(--zth-blue-electric);
}

/* ==========================================================================
   Interactive Diligence Showcase Section
   ========================================================================== */
.interactive-diligence-showcase {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 16px;
  padding: 36px 40px;
  box-shadow: var(--shadow-sm);
  display: flex;
  flex-direction: column;
  gap: 24px;
  margin-top: 12px;
}

.showcase-header {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.showcase-kicker-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.showcase-kicker {
  font-size: 14.5px;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--zth-blue-electric);
}

.showcase-tag {
  font-size: 14.5px;
  font-weight: 600;
  background: #f1f5f9;
  color: var(--zth-text-secondary);
  padding: 2px 8px;
  border-radius: 4px;
}

.showcase-title {
  font-size: 25px;
  font-weight: 800;
  color: var(--zth-navy-primary);
  letter-spacing: -0.015em;
  margin: 0;
}

.showcase-subtitle {
  font-size: 17.5px;
  color: var(--zth-text-secondary);
  line-height: 1.6;
  margin: 0;
  max-width: 820px;
}

.showcase-tab-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 16px;
  border-bottom: 1px solid var(--zth-border);
  padding-bottom: 12px;
}

.showcase-tab-pill {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 16px;
  border-radius: 8px;
  font-size: 16.5px;
  font-weight: 600;
  color: var(--zth-text-secondary);
  background: #f8fafc;
  border: 1px solid transparent;
  transition: all var(--transition-fast);
}

.showcase-tab-pill:hover {
  background: #f1f5f9;
  color: var(--zth-navy-primary);
}

.showcase-tab-pill.active {
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  border-color: #bfdbfe;
  font-weight: 700;
}

.showcase-display-card {
  background: #f8fafc;
  border: 1px solid var(--zth-border);
  border-radius: 12px;
  overflow: hidden;
}

.showcase-tab-panel {
  padding: 28px;
}

/* Showcase Readiness Layout */
.showcase-readiness-layout {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 28px;
  align-items: center;
}

.showcase-score-radial-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 12px;
}

.radial-score-preview {
  position: relative;
  width: 120px;
  height: 120px;
}

.radial-svg {
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}

.radial-bg-circle {
  fill: none;
  stroke: #e2e8f0;
  stroke-width: 8;
}

.radial-progress-circle {
  fill: none;
  stroke: var(--zth-blue-electric);
  stroke-width: 8;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.8s ease;
}

.radial-center-text {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.radial-number {
  font-size: 32px;
  font-weight: 800;
  color: var(--zth-navy-primary);
  line-height: 1;
}

.radial-denom {
  font-size: 14.5px;
  font-weight: 700;
  color: var(--zth-text-secondary);
}

.radial-meta {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.radial-badge {
  font-size: 14.5px;
  font-weight: 700;
  background: #dcfce7;
  color: #15803d;
  padding: 2px 8px;
  border-radius: 12px;
  display: inline-block;
}

.radial-caption {
  font-size: 14.5px;
  color: var(--zth-text-secondary);
}

.showcase-rubric-cards-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14px;
}

.showcase-rubric-card {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 9px;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.rubric-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rubric-name {
  font-size: 16.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
}

.rubric-score-badge {
  font-size: 14.5px;
  font-weight: 800;
  padding: 2px 7px;
  border-radius: 4px;
}

.rubric-score-badge.high {
  background: #dcfce7;
  color: #15803d;
}

.rubric-score-badge.mid {
  background: #fef3c7;
  color: #b45309;
}

.rubric-score-badge.critical {
  background: #fee2e2;
  color: #b91c1c;
}

.rubric-bar-track {
  width: 100%;
  height: 4px;
  background: #e2e8f0;
  border-radius: 4px;
  overflow: hidden;
}

.rubric-bar-fill {
  height: 100%;
  background: var(--zth-blue-electric);
  border-radius: 4px;
}

.rubric-bar-fill.warning-fill {
  background: #ef4444;
}

.rubric-reason {
  font-size: 14.5px;
  line-height: 1.45;
  color: var(--zth-text-secondary);
  margin: 2px 0 0;
}

.rubric-slide-tag {
  font-size: 14.5px;
  font-weight: 600;
  color: var(--zth-blue-bright);
}

.rubric-slide-tag.warning-tag {
  color: #b91c1c;
}

/* Showcase Gaps List */
.showcase-gaps-list {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.showcase-gap-item {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 10px;
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.showcase-gap-item.priority-high {
  border-left: 4px solid #ef4444;
}

.showcase-gap-item.priority-medium {
  border-left: 4px solid #f59e0b;
}

.gap-item-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.gap-priority-badge {
  font-size: 14.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  padding: 2px 8px;
  border-radius: 4px;
}

.gap-priority-badge.high {
  background: #fee2e2;
  color: #b91c1c;
}

.gap-priority-badge.medium {
  background: #fef3c7;
  color: #b45309;
}

.gap-slide-ref {
  font-size: 14.5px;
  font-weight: 600;
  color: var(--zth-text-secondary);
}

.gap-item-title {
  font-size: 17.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 0;
}

.gap-item-desc {
  font-size: 16.5px;
  color: var(--zth-text-secondary);
  line-height: 1.5;
  margin: 0;
}

.gap-recommendation-box {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-radius: 6px;
  padding: 10px 12px;
  font-size: 15.5px;
  color: #166534;
  line-height: 1.45;
}

/* Showcase Simulation Preview */
.showcase-simulation-preview {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.sim-preview-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sim-persona-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 15.5px;
  font-weight: 700;
  color: #b45309;
  background: #fef3c7;
  padding: 3px 10px;
  border-radius: 6px;
}

.sim-focus-tag {
  font-size: 14.5px;
  color: var(--zth-text-secondary);
  font-weight: 500;
}

.sim-question-bubble {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 10px;
  padding: 18px 20px;
}

.bubble-label {
  font-size: 14.5px;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--zth-blue-electric);
  margin-bottom: 6px;
}

.bubble-text {
  font-size: 17.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  line-height: 1.55;
  margin: 0;
}

.sim-feedback-preview {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 10px;
  padding: 18px 20px;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.sim-score-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #f1f5f9;
  padding-bottom: 8px;
  font-size: 14.5px;
  font-weight: 700;
  color: var(--zth-text-secondary);
}

.sim-score-value {
  font-size: 18.5px;
  font-weight: 800;
  color: #15803d;
}

.sim-points-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.sim-point-col strong {
  font-size: 15.5px;
  font-weight: 700;
  display: block;
  margin-bottom: 4px;
}

.sim-point-col.positive strong {
  color: #15803d;
}

.sim-point-col.negative strong {
  color: #b45309;
}

.sim-point-col p {
  font-size: 15.5px;
  line-height: 1.45;
  color: var(--zth-text-secondary);
  margin: 2px 0;
}

/* Showcase Action Bar */
.showcase-action-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18px 24px;
  background: #ffffff;
  border-top: 1px solid var(--zth-border);
  gap: 16px;
}

.action-bar-text {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.action-bar-text strong {
  font-size: 16.5px;
  color: var(--zth-navy-primary);
}

.action-bar-text span {
  font-size: 15.5px;
  color: var(--zth-text-secondary);
}

.showcase-load-btn {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 18px;
  background: var(--zth-blue-electric);
  color: #ffffff;
  border-radius: 8px;
  font-size: 16.5px;
  font-weight: 700;
  white-space: nowrap;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);
  transition: all var(--transition-fast);
}

.showcase-load-btn:hover {
  background: #1d4ed8;
}

/* Empty Evaluation Fallback */
.empty-evaluation-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60px 20px;
}

.empty-fallback-box {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 14px;
  padding: 36px 40px;
  text-align: center;
  max-width: 500px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12px;
  box-shadow: var(--shadow-sm);
}

.empty-fallback-box h3 {
  font-size: 21px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 0;
}

.empty-fallback-box p {
  font-size: 12.5px;
  color: var(--zth-text-secondary);
  line-height: 1.55;
  margin: 0;
}

.empty-fallback-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 8px;
}

.primary-action-btn {
  background: var(--zth-blue-electric);
  color: #ffffff;
  padding: 9px 18px;
  border-radius: 7px;
  font-size: 16.5px;
  font-weight: 600;
  transition: all var(--transition-fast);
}

.primary-action-btn:hover {
  background: #1d4ed8;
}

.secondary-action-btn {
  background: #f1f5f9;
  color: var(--zth-navy-primary);
  padding: 9px 18px;
  border-radius: 7px;
  font-size: 16.5px;
  font-weight: 600;
  transition: all var(--transition-fast);
}

.secondary-action-btn:hover {
  background: #e2e8f0;
}

/* ==========================================================================
   Editorial Minimalist 3D Deck Inspector
   ========================================================================== */
.editorial-deck-showcase {
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1px solid rgba(226, 232, 240, 0.9);
  border-radius: 18px;
  padding: 38px 42px;
  box-shadow: 
    inset 0 1px 0 0 rgba(255, 255, 255, 1),
    0 4px 24px -2px rgba(11, 27, 51, 0.05),
    0 16px 40px -8px rgba(11, 27, 51, 0.07);
  display: flex;
  flex-direction: column;
  gap: 28px;
  position: relative;
  overflow: hidden;
}

.editorial-showcase-header {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.editorial-meta-line {
  display: flex;
  align-items: center;
  gap: 10px;
}

.editorial-mono-kicker {
  font-family: 'SF Mono', ui-monospace, Menlo, Consolas, monospace;
  font-size: 14.5px;
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--zth-blue-electric);
  text-transform: uppercase;
}

.editorial-divider-dot {
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: #cbd5e1;
}

.editorial-badge {
  font-size: 14.5px;
  font-weight: 600;
  color: #475569;
  background: #f1f5f9;
  padding: 2px 8px;
  border-radius: 12px;
}

.editorial-title {
  font-size: clamp(22px, 2.4vw, 28px);
  font-weight: 800;
  color: var(--zth-navy-primary);
  letter-spacing: -0.025em;
  margin: 0;
}

.editorial-description {
  font-size: 17.5px;
  color: var(--zth-text-secondary);
  line-height: 1.55;
  margin: 0;
  max-width: 800px;
}

.editorial-showcase-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 32px;
  align-items: stretch;
}

/* 3D Stage & Card */
.deck-3d-stage {
  perspective: 1200px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  min-height: 480px;
}

.deck-ambient-glow {
  position: absolute;
  inset: 10% 15%;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.15) 0%, transparent 70%);
  filter: blur(40px);
  z-index: 0;
  pointer-events: none;
}

.deck-3d-card {
  width: 100%;
  background: #ffffff;
  border: 1px solid rgba(226, 232, 240, 0.95);
  border-radius: 14px;
  box-shadow: 
    0 20px 48px -12px rgba(11, 27, 51, 0.16),
    0 8px 16px -4px rgba(11, 27, 51, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 1);
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
  overflow: hidden;
  transition: box-shadow 0.3s ease;
}

.deck-card-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 18px;
  background: #f8fafc;
  border-bottom: 1px solid var(--zth-border);
}

.deck-card-dots {
  display: flex;
  gap: 6px;
}

.window-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
}

.window-dot.red { background: #ef4444; opacity: 0.8; }
.window-dot.yellow { background: #f59e0b; opacity: 0.8; }
.window-dot.green { background: #10b981; opacity: 0.8; }

.deck-card-title-pill {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
}

.deck-page-badge {
  font-size: 14.5px;
  font-weight: 700;
  color: var(--zth-blue-electric);
  background: var(--zth-blue-pale);
  padding: 1px 7px;
  border-radius: 10px;
}

.deck-card-status {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14.5px;
  font-weight: 600;
  color: #15803d;
}

.pulse-live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #10b981;
  box-shadow: 0 0 8px rgba(16, 185, 129, 0.6);
  animation: pulseDot 2s infinite ease-in-out;
}

@keyframes pulseDot {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.3); opacity: 0.6; }
}

/* Slide Presentation Canvas & Structured Visual Cards */
.slide-canvas-viewport {
  width: 100%;
  max-width: 820px;
  margin: 0 auto;
  display: flex;
  justify-content: center;
  align-items: flex-start;
  padding: 16px 20px;
}

.slide-canvas-card {
  width: 100%;
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: var(--zth-radius-md);
  box-shadow: 0 4px 20px rgba(11, 27, 51, 0.05);
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.slide-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 20px;
  background: var(--zth-surface-subtle);
  border-bottom: 1px solid var(--zth-border-subtle);
}

.slide-category-tag {
  display: flex;
  align-items: center;
  gap: 8px;
}

.slide-num-pill {
  font-size: 11px;
  font-weight: 700;
  padding: 2px 7px;
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  border-radius: 4px;
}

.slide-cat-name {
  font-size: 12px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  text-transform: uppercase;
  letter-spacing: 0.03em;
}

.slide-status-indicator {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11.5px;
  font-weight: 600;
  padding: 3px 9px;
  border-radius: 12px;
}

.slide-status-indicator.critical {
  background: #fef2f2;
  color: #b91c1c;
  border: 1px solid #fecaca;
}

.slide-status-indicator.strong,
.slide-status-indicator.good {
  background: #ecfdf5;
  color: #047857;
  border: 1px solid #a7f3d0;
}

.slide-card-body {
  padding: 22px 24px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.slide-header-block {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.slide-headline-text {
  font-size: 19px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  line-height: 1.3;
  margin: 0;
  letter-spacing: -0.01em;
}

.slide-subhead-text {
  font-size: 13px;
  color: var(--zth-text-secondary);
  line-height: 1.5;
  margin: 0;
}

.slide-cards-grid {
  display: grid;
  gap: 12px;
}

.slide-cards-grid.grid-3-cols {
  grid-template-columns: repeat(3, 1fr);
}

.executive-card {
  background: var(--zth-surface-subtle);
  border: 1px solid var(--zth-border);
  border-radius: var(--zth-radius-sm);
  padding: 13px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: all var(--zth-transition-fast);
}

.executive-card:hover {
  border-color: #cbd5e1;
  box-shadow: 0 2px 8px rgba(11, 27, 51, 0.04);
}

.exec-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.exec-avatar-icon {
  width: 26px;
  height: 26px;
  border-radius: 6px;
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  display: flex;
  align-items: center;
  justify-content: center;
}

.exec-role-pill {
  font-size: 10.5px;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 4px;
  background: #f1f5f9;
  color: var(--zth-navy-primary);
}

.exec-role-pill.success {
  background: #ecfdf5;
  color: #047857;
}

.exec-role-pill.warning {
  background: #fffbeb;
  color: #b45309;
}

.exec-role-pill.danger {
  background: #fef2f2;
  color: #b91c1c;
}

.exec-card-name {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0;
}

.exec-card-desc {
  font-size: 12px;
  color: var(--zth-text-secondary);
  line-height: 1.45;
  margin: 0;
}

.exec-stat-chips-group {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.visual-stat-pill {
  font-size: 11px;
  font-weight: 600;
  padding: 2px 6px;
  border-radius: 4px;
  background: #f8fafc;
  border: 1px solid var(--zth-border);
  color: var(--zth-text-secondary);
}

.visual-stat-pill.highlight {
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  border-color: #bfdbfe;
}

.visual-stat-pill.danger {
  background: #fef2f2;
  color: #b91c1c;
  border-color: #fecaca;
}

.visual-stat-pill.warning {
  background: #fffbeb;
  color: #b45309;
  border-color: #fde68a;
}

.problem-card {
  border-left: 3px solid #ef4444;
}

.problem-num-badge {
  font-size: 10.5px;
  font-weight: 700;
  color: #dc2626;
  background: #fef2f2;
  padding: 2px 6px;
  border-radius: 4px;
}

.problem-stat-badge {
  font-size: 11.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
}

.slide-pipeline-workflow {
  display: flex;
  align-items: center;
  gap: 8px;
}

.pipeline-node-card {
  flex: 1;
  background: var(--zth-surface-subtle);
  border: 1px solid var(--zth-border);
  border-radius: var(--zth-radius-sm);
  padding: 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.pipeline-node-card.highlight {
  border-color: var(--zth-blue-electric);
  background: #eff6ff;
}

.pipeline-node-card.success {
  border-color: #10b981;
  background: #f0fdf4;
}

.pipeline-node-step {
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--zth-text-muted);
}

.pipeline-node-title {
  font-size: 13px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0;
}

.pipeline-node-desc {
  font-size: 11.5px;
  color: var(--zth-text-secondary);
  line-height: 1.4;
  margin: 0;
}

.pipeline-status-tag {
  font-size: 10.5px;
  font-weight: 600;
  color: var(--zth-text-secondary);
  margin-top: 4px;
}

.pipeline-status-tag.active {
  color: var(--zth-blue-electric);
  font-weight: 700;
}

.pipeline-connector-flow {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
}

.real-slide-rubrics-banner {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  padding: 8px 12px;
  background: var(--zth-surface-subtle);
  border: 1px solid var(--zth-border-subtle);
  border-radius: var(--zth-radius-sm);
}

.real-rubric-chip {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 11.5px;
}

.real-rubric-name {
  font-weight: 500;
  color: var(--zth-navy-primary);
}

.real-rubric-score {
  font-weight: 700;
  padding: 1px 6px;
  border-radius: 4px;
  font-size: 10.5px;
}

.real-rubric-score.score-high {
  background: #dcfce7;
  color: #15803d;
}

.real-rubric-score.score-mid {
  background: #fef3c7;
  color: #b45309;
}

.real-rubric-score.score-low {
  background: #fee2e2;
  color: #b91c1c;
}

.structured-bullet-card {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 9px 12px;
  background: var(--zth-surface-subtle);
  border: 1px solid var(--zth-border-subtle);
  border-radius: var(--zth-radius-sm);
  font-size: 12.5px;
  line-height: 1.5;
}

.bullet-num-circle {
  width: 20px;
  height: 20px;
  border-radius: 50%;
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 11px;
  font-weight: 700;
  flex-shrink: 0;
}

.bullet-lead-text {
  font-weight: 600;
  color: var(--zth-navy-primary);
}

.bullet-rest-text {
  color: var(--zth-text-secondary);
}

.real-slide-section {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.real-section-label {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 12.5px;
  font-weight: 600;
  margin: 0;
}

.real-section-label.verified {
  color: #047857;
}

.real-section-label.risk {
  color: #b91c1c;
}

.real-slide-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
  gap: 10px;
}

.pdf-embed-wrapper {
  width: 100%;
  height: 100%;
  min-height: 520px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pdf-native-iframe {
  width: 100%;
  height: 100%;
  min-height: 520px;
  border: none;
  background: #ffffff;
}

.deck-card-canvas {
  padding: 24px;
  min-height: 310px;
  display: flex;
  flex-direction: column;
  background: #ffffff;
}

.slide-canvas-content {
  display: flex;
  flex-direction: column;
  gap: 12px;
  height: 100%;
}

.slide-content-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.slide-category-eyebrow {
  font-size: 14.5px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--zth-blue-electric);
}

.slide-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 14.5px;
  font-weight: 700;
  padding: 3px 9px;
  border-radius: 12px;
}

.slide-status-pill.strong {
  background: #dcfce7;
  color: #15803d;
}

.slide-status-pill.good {
  background: #fef3c7;
  color: #b45309;
}

.slide-status-pill.critical {
  background: #fee2e2;
  color: #b91c1c;
}

.slide-main-headline {
  font-size: 23px;
  font-weight: 800;
  color: var(--zth-navy-primary);
  line-height: 1.3;
  letter-spacing: -0.015em;
  margin: 0;
}

.slide-main-subhead {
  font-size: 16.5px;
  color: var(--zth-text-secondary);
  line-height: 1.5;
  margin: 0;
}

.slide-bullet-list {
  display: flex;
  flex-direction: column;
  gap: 6px;
  margin-top: 4px;
}

.slide-bullet-item {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15.5px;
  color: #334155;
}

.slide-bullet-bullet {
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: var(--zth-blue-electric);
  flex-shrink: 0;
}

.slide-mock-visualization {
  margin-top: auto;
  padding-top: 16px;
  border-top: 1px dashed #e2e8f0;
}

.mock-team-layout {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.team-pill-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  border-radius: 6px;
  padding: 6px 10px;
  font-size: 14.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
}

.mock-tech-graph {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 15.5px;
}

.tech-node {
  padding: 6px 12px;
  border-radius: 6px;
  font-weight: 700;
  font-size: 14.5px;
}

.tech-node.source { background: #f1f5f9; color: var(--zth-navy-primary); border: 1px solid #cbd5e1; }
.tech-node.engine { background: var(--zth-blue-pale); color: var(--zth-blue-electric); border: 1px solid #93c5fd; }
.tech-node.output { background: #dcfce7; color: #15803d; border: 1px solid #86efac; }

.tech-arrow { color: #94a3b8; font-weight: 700; }

.mock-traction-bars {
  display: flex;
  align-items: flex-end;
  gap: 16px;
  height: 60px;
  padding: 0 10px;
}

.bar-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4px;
  height: 100%;
  justify-content: flex-end;
}

.bar-col .bar-fill {
  width: 100%;
  background: #e2e8f0;
  border-radius: 4px 4px 0 0;
  transition: height 0.4s ease;
}

.bar-col.active .bar-fill {
  background: var(--zth-blue-electric);
}

.bar-col span {
  font-size: 14.5px;
  font-weight: 700;
  color: var(--zth-text-secondary);
}

.mock-alert-strip {
  display: flex;
  align-items: center;
  gap: 8px;
  background: #fef2f2;
  border: 1px solid #fecaca;
  border-radius: 6px;
  padding: 8px 12px;
  font-size: 15.5px;
  color: #991b1b;
}

.deck-slide-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid var(--zth-border);
  background: #f8fafc;
}

.slide-thumbnail-btn {
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 3px;
  border-right: 1px solid var(--zth-border);
  transition: all var(--transition-fast);
  text-align: left;
}

.slide-thumbnail-btn:last-child {
  border-right: none;
}

.slide-thumbnail-btn:hover {
  background: #f1f5f9;
}

.slide-thumbnail-btn.active {
  background: #ffffff;
  box-shadow: inset 0 -2px 0 var(--zth-blue-electric);
}

.thumb-num {
  font-size: 14.5px;
  font-weight: 700;
  color: var(--zth-text-secondary);
}

.thumb-title {
  font-size: 14.5px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 100%;
}

.thumb-score-pill {
  font-size: 14.5px;
  font-weight: 800;
  padding: 1px 5px;
  border-radius: 4px;
}

.thumb-score-pill.strong { background: #dcfce7; color: #15803d; }
.thumb-score-pill.good { background: #fef3c7; color: #b45309; }
.thumb-score-pill.critical { background: #fee2e2; color: #b91c1c; }

/* Right Column: Telemetry Inspector */
.deck-telemetry-inspector {
  display: flex;
  flex-direction: column;
}

.inspector-card {
  height: 100%;
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 14px;
  padding: 26px;
  display: flex;
  flex-direction: column;
  gap: 18px;
  box-shadow: 0 4px 16px -2px rgba(11, 27, 51, 0.04);
}

.inspector-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #f1f5f9;
  padding-bottom: 12px;
}

.inspector-tag {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14.5px;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: var(--zth-blue-electric);
}

.citation-tag {
  font-size: 14.5px;
  font-weight: 600;
  color: var(--zth-text-secondary);
  background: #f1f5f9;
  padding: 2px 8px;
  border-radius: 4px;
}

.inspector-score-row {
  display: flex;
  align-items: center;
  gap: 18px;
}

.score-radial-minimal {
  display: flex;
  align-items: baseline;
  background: #f8fafc;
  border: 1px solid var(--zth-border);
  padding: 8px 14px;
  border-radius: 10px;
}

.score-radial-minimal .score-val {
  font-size: 38px;
  font-weight: 900;
  color: var(--zth-navy-primary);
  line-height: 1;
}

.score-radial-minimal .score-max {
  font-size: 16.5px;
  font-weight: 700;
  color: var(--zth-text-secondary);
}

.score-meta-block {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.score-category-name {
  font-size: 17.5px;
  font-weight: 800;
  color: var(--zth-navy-primary);
}

.score-benchmark-label {
  font-size: 14.5px;
  font-weight: 700;
}

.score-benchmark-label.strong { color: #15803d; }
.score-benchmark-label.good { color: #b45309; }
.score-benchmark-label.critical { color: #b91c1c; }

.inspector-analysis-section {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.analysis-heading {
  font-size: 15.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--zth-text-secondary);
  margin: 0;
}

.analysis-body-text {
  font-size: 16.5px;
  color: var(--zth-navy-primary);
  line-height: 1.55;
  margin: 0;
}

.inspector-partner-box {
  background: #f8fafc;
  border: 1px solid var(--zth-border);
  border-radius: 10px;
  padding: 14px 16px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.partner-box-header {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 14.5px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--zth-blue-bright);
}

.partner-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--zth-blue-electric);
}

.partner-question-quote {
  font-size: 15.5px;
  font-style: italic;
  line-height: 1.5;
  color: #1e293b;
  margin: 0;
}

.inspector-cta-box {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.inspector-explore-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 18px;
  background: var(--zth-blue-electric);
  color: #ffffff;
  border-radius: 8px;
  font-size: 16.5px;
  font-weight: 700;
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.28);
  transition: all var(--transition-fast);
}

.inspector-explore-btn:hover {
  background: #1d4ed8;
  box-shadow: 0 6px 20px rgba(37, 99, 235, 0.38);
}

.inspector-subtext {
  font-size: 14.5px;
  color: var(--zth-text-secondary);
  text-align: center;
}

@media (max-width: 992px) {
  .editorial-showcase-grid {
    grid-template-columns: 1fr;
  }
}

/* ============================/* ==========================================================================
   Split-Screen Studio Cockpit Layout
   ========================================================================== */
.cockpit-main-frame {
  flex: 1;
  display: flex;
  height: calc(100vh - 52px);
  overflow: hidden;
  padding: 0 !important;
  margin: 0 !important;
  max-width: 100% !important;
}

.cockpit-studio-layout {
  display: flex;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

/* Left Pane: Presentation Deck Viewer */
.cockpit-viewer-wrapper {
  flex: 1.5;
  min-width: 0;
  height: 100%;
  border-right: 1px solid var(--zth-border);
  background: #f8fafc;
  display: flex;
  flex-direction: column;
}

.cockpit-viewer-pane {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
  overflow: hidden;
}

.viewer-pane-header {
  height: 48px;
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(18px) saturate(150%);
  -webkit-backdrop-filter: blur(18px) saturate(150%);
  border-bottom: 1px solid rgba(226, 232, 240, 0.60);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  gap: 12px;
  flex-shrink: 0;
  box-shadow: 0 1px 0 rgba(255,255,255,0.90) inset;
}

.viewer-title-group {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.viewer-sidebar-toggle-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 5px;
  border: 1px solid var(--zth-border);
  background: #ffffff;
  color: #475569;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.viewer-sidebar-toggle-btn:hover {
  background: #f1f5f9;
  color: var(--zth-navy-primary);
}

.viewer-file-name {
  font-size: 13.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 260px;
}

.viewer-slide-badge {
  font-size: 11px;
  font-weight: 600;
  color: var(--zth-blue-electric);
  background: var(--zth-blue-pale);
  padding: 2px 8px;
  border-radius: 4px;
  white-space: nowrap;
}

.viewer-controls-group {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
  white-space: nowrap;
}

.viewer-nav-controls {
  display: flex;
  align-items: center;
  gap: 4px;
  white-space: nowrap;
  flex-shrink: 0;
}

.viewer-nav-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  height: 28px;
  padding: 0 9px;
  border-radius: 5px;
  font-size: 12px;
  font-weight: 500;
  color: var(--zth-navy-primary);
  background: #f1f5f9;
  border: 1px solid #e2e8f0;
  transition: all var(--transition-fast);
  cursor: pointer;
}

.viewer-nav-btn:hover:not(:disabled) {
  background: #e2e8f0;
  color: var(--zth-blue-electric);
  border-color: #cbd5e1;
}

.viewer-nav-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.viewer-slide-counter {
  font-size: 12px;
  font-weight: 600;
  color: #475569;
  padding: 0 6px;
  min-width: 44px;
  text-align: center;
  white-space: nowrap;
}

.viewer-zoom-controls {
  display: flex;
  align-items: center;
  gap: 2px;
  background: #f1f5f9;
  border: 1px solid #e2e8f0;
  border-radius: 5px;
  padding: 1px;
  height: 28px;
}

.viewer-zoom-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 24px;
  height: 24px;
  border-radius: 4px;
  color: #475569;
  background: transparent;
  border: none;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.viewer-zoom-btn:hover:not(:disabled) {
  background: #ffffff;
  color: var(--zth-blue-electric);
  box-shadow: 0 1px 2px rgba(11, 27, 51, 0.06);
}

.viewer-zoom-btn:disabled {
  opacity: 0.4;
  cursor: not-allowed;
}

.viewer-zoom-label {
  font-size: 11px;
  font-weight: 600;
  color: #475569;
  min-width: 38px;
  text-align: center;
  background: none;
  border: none;
  cursor: pointer;
  padding: 0 4px;
}

.viewer-header-actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.viewer-mode-toggle {
  display: flex;
  background: #f1f5f9;
  border: 1px solid #e2e8f0;
  border-radius: 5px;
  padding: 1px;
}

.viewer-mode-toggle .mode-btn {
  font-size: 11.5px;
  font-weight: 500;
  padding: 3px 8px;
  border-radius: 4px;
  border: none;
  background: transparent;
  color: #64748b;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.viewer-mode-toggle .mode-btn.active {
  background: #ffffff;
  color: var(--zth-blue-electric);
  font-weight: 600;
  box-shadow: 0 1px 2px rgba(11, 27, 51, 0.08);
}

.viewer-switch-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  height: 28px;
  padding: 0 9px;
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 5px;
  font-size: 12px;
  font-weight: 500;
  color: var(--zth-text-secondary);
  cursor: pointer;
  transition: all var(--transition-fast);
}

.viewer-switch-btn:hover {
  background: #f8fafc;
  border-color: #cbd5e1;
  color: var(--zth-navy-primary);
}

/* Viewer Slide Stage & Presentation Canvas */
.viewer-content-viewport {
  flex: 1;
  display: flex;
  overflow: hidden;
  position: relative;
}

.viewer-thumb-sidebar {
  width: 200px;
  background: #ffffff;
  border-right: 1px solid var(--zth-border);
  display: flex;
  flex-direction: column;
  overflow-y: auto;
  padding: 8px;
  gap: 6px;
  flex-shrink: 0;
}

.sidebar-thumb-card {
  display: flex;
  flex-direction: column;
  padding: 8px 10px;
  border-radius: 6px;
  border: 1px solid var(--zth-border);
  background: #f8fafc;
  cursor: pointer;
  text-align: left;
  transition: all var(--transition-fast);
}

.sidebar-thumb-card:hover {
  background: #f1f5f9;
  border-color: #cbd5e1;
}

.sidebar-thumb-card.active {
  background: var(--zth-blue-pale);
  border-color: #93c5fd;
  box-shadow: 0 1px 3px rgba(37, 99, 235, 0.1);
}

.thumb-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.thumb-card-num {
  font-size: 10.5px;
  font-weight: 700;
  color: #64748b;
}

.thumb-status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.thumb-status-dot.critical { background: #ef4444; }
.thumb-status-dot.strong { background: #22c55e; }
.thumb-status-dot.good { background: #3b82f6; }

.thumb-card-title {
  font-size: 11.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin-top: 2px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.thumb-card-cat {
  font-size: 10px;
  color: #64748b;
}

.viewer-slide-stage {
  flex: 1;
  position: relative;
  overflow: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24px;
  background-color: #f8fafc;
  background-image: radial-gradient(rgba(148, 163, 184, 0.2) 1px, transparent 1px);
  background-size: 20px 20px;
}

.viewer-slide-stage.is-dragging-stage {
  background-color: rgba(239, 246, 255, 0.92);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  outline: 2px dashed rgba(37, 99, 235, 0.70);
  outline-offset: -8px;
  box-shadow: inset 0 0 40px rgba(37, 99, 235, 0.06);
}

.viewer-upload-stage {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.viewer-upload-card {
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  max-width: 440px;
  width: 100%;
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(18px) saturate(150%);
  -webkit-backdrop-filter: blur(18px) saturate(150%);
  border: 1px solid rgba(255, 255, 255, 0.70);
  border-radius: 12px;
  padding: 28px 24px;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: 10px;
  box-shadow: 0 8px 28px rgba(11,27,51,0.06), inset 0 1px 0 rgba(255,255,255,0.90);
}

.viewer-upload-card.ready-state {
  border-color: #bbf7d0;
  background: #ffffff;
}

.viewer-upload-icon-circle {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: var(--zth-blue-pale);
  display: grid;
  place-items: center;
}

.viewer-upload-icon-circle.ready {
  background: #dcfce7;
}

.viewer-upload-title {
  font-size: 16.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0;
  letter-spacing: -0.01em;
}

.viewer-upload-subtext {
  font-size: 12.5px;
  color: var(--zth-text-secondary);
  line-height: 1.45;
  margin: 0;
  max-width: 320px;
}

.viewer-upload-browse-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 34px;
  padding: 0 16px;
  background: var(--zth-blue-electric);
  color: #ffffff;
  border-radius: 6px;
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
  margin-top: 4px;
}

.viewer-upload-browse-btn:hover {
  background: var(--zth-blue-hover);
  transform: translateY(-1px);
  box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);
}

.viewer-upload-meta-pills {
  display: flex;
  gap: 6px;
  justify-content: center;
  margin-top: 2px;
}

.upload-meta-pill {
  font-size: 11px;
  font-weight: 500;
  color: #64748b;
  background: #f1f5f9;
  padding: 2px 8px;
  border-radius: 4px;
  border: 1px solid #e2e8f0;
}

.viewer-upload-hint-subtle {
  font-size: 11px;
  color: #94a3b8;
  margin-top: 4px;
}

.ready-deck-pill {
  font-size: 11px;
  font-weight: 600;
  color: #15803d;
  background: #dcfce7;
  padding: 2px 8px;
  border-radius: 12px;
}

.viewer-deck-ready-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 6px;
}

.viewer-evaluate-now-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 34px;
  padding: 0 16px;
  background: var(--zth-blue-electric);
  color: #ffffff;
  border-radius: 6px;
  font-size: 12.5px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  transition: all var(--transition-fast);
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
}

.viewer-evaluate-now-btn:hover {
  background: var(--zth-blue-hover);
  transform: translateY(-1px);
}

.viewer-change-deck-btn {
  display: inline-flex;
  align-items: center;
  height: 34px;
  padding: 0 12px;
  background: #f8fafc;
  color: var(--zth-text-secondary);
  border: 1px solid var(--zth-border);
  border-radius: 6px;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.viewer-change-deck-btn:hover {
  background: #f1f5f9;
  color: var(--zth-navy-primary);
}

/* Native PDF Embed View */
.native-pdf-frame-wrapper {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #1e293b;
  border-radius: 8px;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(15, 23, 42, 0.15);
}

.native-pdf-embed {
  width: 100%;
  height: 100%;
  border: none;
}

/* AI Extracted Slide View */
.slide-presentation-card {
  width: 100%;
  max-width: 820px;
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 12px;
  padding: 24px 28px;
  box-shadow: 0 8px 30px rgba(11, 27, 51, 0.08);
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.slide-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #f1f5f9;
  padding-bottom: 12px;
}

.slide-category-tag {
  display: flex;
  align-items: center;
  gap: 8px;
}

.slide-num-pill {
  font-size: 11px;
  font-weight: 700;
  color: var(--zth-blue-electric);
  background: var(--zth-blue-pale);
  padding: 2px 7px;
  border-radius: 4px;
}

.slide-cat-name {
  font-size: 12px;
  font-weight: 600;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.slide-status-indicator {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  font-size: 11px;
  font-weight: 600;
  padding: 3px 8px;
  border-radius: 10px;
}

.slide-status-indicator.critical {
  background: #fee2e2;
  color: #b91c1c;
}

.slide-status-indicator.verified {
  background: #dcfce7;
  color: #15803d;
}

.slide-header-block {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.slide-headline-text {
  font-size: 18px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  margin: 0;
  letter-spacing: -0.01em;
}

.slide-subhead-text {
  font-size: 13px;
  color: var(--zth-text-secondary);
  line-height: 1.5;
  margin: 0;
}

.slide-bullets-block {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 4px;
}

.slide-bullet-row {
  display: flex;
  align-items: flex-start;
  gap: 10px;
}

.slide-bullet-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--zth-blue-electric);
  margin-top: 7px;
  flex-shrink: 0;
}

.slide-bullet-text {
  font-size: 13px;
  line-height: 1.5;
  color: #334155;
}

/* ==========================================================================
   Right Pane: AI Console
   ========================================================================== */
.cockpit-console-wrapper {
  width: 440px;
  min-width: 380px;
  max-width: 480px;
  height: 100%;
  background: rgba(255, 255, 255, 0.94);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  display: flex;
  flex-direction: column;
  flex-shrink: 0;
  border-left: 1px solid rgba(226, 232, 240, 0.60);
}

.cockpit-console-pane {
  display: flex;
  flex-direction: column;
  height: 100%;
  width: 100%;
  overflow: hidden;
}

.console-segmented-header {
  height: 48px;
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(18px) saturate(150%);
  -webkit-backdrop-filter: blur(18px) saturate(150%);
  border-bottom: 1px solid rgba(226, 232, 240, 0.60);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10px;
  gap: 6px;
  flex-shrink: 0;
  box-shadow: 0 1px 0 rgba(255,255,255,0.90) inset;
}

.segmented-tab-group {
  display: flex;
  align-items: center;
  gap: 2px;
  background: rgba(241, 245, 249, 0.70);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  border: 1px solid rgba(226, 232, 240, 0.65);
  border-radius: 6px;
  padding: 2px;
  flex: 1;
}

.segmented-tab-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 5px;
  height: 28px;
  padding: 0 9px;
  border-radius: 4px;
  border: none;
  background: transparent;
  font-size: 12px;
  font-weight: 500;
  color: var(--zth-text-secondary);
  cursor: pointer;
  transition: all var(--transition-fast);
  flex: 1;
  white-space: nowrap;
}

.segmented-tab-btn:hover {
  color: var(--zth-navy-primary);
  background: rgba(255, 255, 255, 0.65);
}

.segmented-tab-btn.active {
  background: #ffffff;
  color: var(--zth-blue-electric);
  font-weight: 600;
  box-shadow: 0 1px 3px rgba(11, 27, 51, 0.08);
}

.tab-pill-metric {
  font-size: 10.5px;
  font-weight: 700;
  background: #dcfce7;
  color: #15803d;
  padding: 1px 5px;
  border-radius: 4px;
}

.tab-pill-alert {
  font-size: 10.5px;
  font-weight: 700;
  background: #fee2e2;
  color: #b91c1c;
  padding: 1px 5px;
  border-radius: 4px;
}

.console-setup-trigger {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 5px;
  border: 1px solid var(--zth-border);
  background: #f8fafc;
  color: var(--zth-text-secondary);
  cursor: pointer;
  transition: all var(--transition-fast);
  flex-shrink: 0;
}

.console-setup-trigger:hover {
  background: #f1f5f9;
  color: var(--zth-navy-primary);
  border-color: #cbd5e1;
}

.console-setup-trigger.active {
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  border-color: #bfdbfe;
}

.console-tab-content {
  flex: 1;
  overflow-y: auto;
  padding: 14px;
}

.console-empty-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  height: 100%;
  padding: 24px 16px;
  gap: 8px;
}

.console-empty-prompt h4 {
  font-size: 15px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0;
}

.console-empty-prompt p {
  font-size: 12.5px;
  color: var(--zth-text-secondary);
  margin: 0;
  max-width: 280px;
  line-height: 1.45;
}

.console-action-primary {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  height: 32px;
  padding: 0 14px;
  background: var(--zth-blue-electric);
  color: #ffffff;
  border-radius: 6px;
  font-size: 12.5px;
  font-weight: 600;
  border: none;
  cursor: pointer;
  transition: all var(--transition-fast);
  margin-top: 6px;
}

.console-action-primary:hover {
  background: var(--zth-blue-hover);
}

/* ==========================================================================
   Tab 5: Setup & Upload Styles
   ========================================================================== */
.setup-workspace {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.setup-heading-group {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.setup-main-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0;
}

.setup-description {
  font-size: 12px;
  color: var(--zth-text-secondary);
  line-height: 1.4;
  margin: 0;
}

.setup-dropzone-box {
  width: 100%;
}

.dropzone-box.compact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  border: 1px dashed #cbd5e1;
  border-radius: 8px;
  background: #f8fafc;
  gap: 10px;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.dropzone-box.compact:hover {
  border-color: var(--zth-blue-electric);
  background: #f0f7ff;
}

.dropzone-compact-main {
  display: flex;
  align-items: center;
  gap: 8px;
}

.dropzone-compact-icon-wrap {
  width: 28px;
  height: 28px;
  border-radius: 6px;
  background: var(--zth-blue-pale);
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.dropzone-compact-text {
  display: flex;
  flex-direction: column;
}

.dropzone-compact-title {
  font-size: 12px;
  font-weight: 600;
  color: var(--zth-navy-primary);
}

.dropzone-compact-meta {
  font-size: 10.5px;
  color: #64748b;
}

.dropzone-compact-btn {
  font-size: 11.5px;
  font-weight: 600;
  color: var(--zth-blue-electric);
  background: #ffffff;
  border: 1px solid #bfdbfe;
  padding: 4px 8px;
  border-radius: 5px;
  cursor: pointer;
  flex-shrink: 0;
  transition: all var(--transition-fast);
}

.dropzone-compact-btn:hover {
  background: var(--zth-blue-pale);
}

.file-selected-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  border: 1px solid #bbf7d0;
  background: #f0fdf4;
  border-radius: 8px;
  gap: 10px;
}

.file-selected-main {
  display: flex;
  align-items: center;
  gap: 8px;
  min-width: 0;
}

.file-icon-box {
  width: 28px;
  height: 28px;
  border-radius: 5px;
  background: #dcfce7;
  display: grid;
  place-items: center;
  flex-shrink: 0;
}

.file-info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.file-name-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.file-name {
  font-size: 12px;
  font-weight: 600;
  color: #14532d;
  max-width: 150px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.file-status-badge {
  font-size: 10px;
  font-weight: 600;
  color: #15803d;
  background: #dcfce7;
  padding: 1px 5px;
  border-radius: 4px;
  display: inline-flex;
  align-items: center;
  gap: 3px;
}

.file-size {
  font-size: 10.5px;
  color: #4b7a5a;
}

.file-actions {
  display: flex;
  align-items: center;
  gap: 4px;
  flex-shrink: 0;
}

.file-action-btn {
  font-size: 11px;
  font-weight: 500;
  height: 24px;
  padding: 0 6px;
  border-radius: 4px;
  background: #ffffff;
  border: 1px solid #cbd5e1;
  color: #475569;
  display: inline-flex;
  align-items: center;
  gap: 3px;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.file-action-btn:hover {
  background: #f8fafc;
  color: var(--zth-navy-primary);
}

.file-action-btn.text-danger:hover {
  color: #dc2626;
  border-color: #fca5a5;
  background: #fef2f2;
}

/* Startup Context Form Controls */
.startup-context-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.form-primary-grid {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.form-field {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.form-field label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: #475569;
  display: flex;
  align-items: center;
  gap: 5px;
}

.required-star {
  color: #ef4444;
}

.stage-pill-selector {
  display: flex;
  background: #f1f5f9;
  border: 1px solid #e2e8f0;
  border-radius: 7px;
  padding: 2px;
  gap: 2px;
}

.stage-pill-btn {
  flex: 1;
  font-size: 12px;
  font-weight: 500;
  padding: 5px 6px;
  border-radius: 5px;
  border: none;
  background: transparent;
  color: var(--zth-text-secondary);
  cursor: pointer;
  transition: all var(--transition-fast);
  text-align: center;
  white-space: nowrap;
}

.stage-pill-btn:hover {
  color: var(--zth-text-main);
}

.stage-pill-btn.active {
  background: #ffffff;
  color: var(--zth-blue-electric);
  font-weight: 600;
  box-shadow: 0 1px 3px rgba(11, 27, 51, 0.08);
}

.form-field input,
.form-field select {
  height: 34px;
  font-size: 12.5px;
  padding: 0 10px;
  border-radius: 6px;
  border: 1px solid var(--zth-border);
  background: #ffffff;
  color: var(--zth-text-main);
  transition: all var(--transition-fast);
}

.form-field input:focus,
.form-field select:focus {
  border-color: var(--zth-blue-electric);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  outline: none;
}

.industry-quick-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 4px;
  margin-top: 4px;
}

.industry-chip-btn {
  font-size: 11px;
  padding: 2px 7px;
  border-radius: 10px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  color: #475569;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.industry-chip-btn:hover {
  background: #f1f5f9;
  border-color: #cbd5e1;
  color: var(--zth-navy-primary);
}

.industry-chip-btn.active {
  background: var(--zth-blue-pale);
  border-color: #bfdbfe;
  color: var(--zth-blue-electric);
  font-weight: 600;
}

.expandable-details-section {
  border-top: 1px solid #f1f5f9;
  padding-top: 8px;
}

.details-toggle-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  padding: 7px 8px;
  border-radius: 6px;
  background: #f8fafc;
  border: 1px solid #e2e8f0;
  color: #475569;
  font-size: 12px;
  font-weight: 500;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.details-toggle-btn:hover {
  background: #f1f5f9;
  color: var(--zth-navy-primary);
}

.toggle-btn-left {
  display: flex;
  align-items: center;
  gap: 6px;
}

.optional-badge {
  font-size: 10px;
  font-weight: 600;
  color: var(--zth-blue-electric);
  background: var(--zth-blue-pale);
  padding: 1px 5px;
  border-radius: 3px;
}

.optional-details-panel {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 8px;
  padding: 10px 12px;
  background: #f8fafc;
  border-radius: 7px;
  border: 1px solid #e2e8f0;
}

.details-help-text {
  font-size: 11.5px;
  color: #64748b;
  margin: 0;
  line-height: 1.4;
}

.details-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.details-grid .full-width {
  grid-column: span 2;
}

.console-evaluate-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: 100%;
  height: 36px;
  background: var(--zth-blue-electric);
  color: #ffffff;
  font-size: 12.5px;
  font-weight: 600;
  border-radius: 6px;
  cursor: pointer;
  transition: all var(--transition-fast);
  border: none;
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.25);
}

.console-evaluate-btn:hover:not(:disabled) {
  background: var(--zth-blue-hover);
  transform: translateY(-1px);
  box-shadow: 0 4px 10px rgba(37, 99, 235, 0.3);
}

.console-evaluate-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* ==========================================================================
   Tab 1: Insights & Hero Radial Scorecard
   ========================================================================== */
.insights-workspace {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.visual-hero-scorecard {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 9px;
  padding: 12px 14px;
  display: flex;
  align-items: center;
  gap: 14px;
  box-shadow: 0 1px 3px rgba(11, 27, 51, 0.04);
}

.hero-radial-gauge {
  position: relative;
  width: 64px;
  height: 64px;
  flex-shrink: 0;
}

.radial-svg {
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}

.radial-track {
  fill: none;
  stroke: #f1f5f9;
}

.radial-meter {
  fill: none;
  stroke: var(--zth-blue-electric);
  stroke-linecap: round;
  transition: stroke-dashoffset 0.8s ease;
}

.radial-score-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.radial-big-score {
  font-size: 22px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  line-height: 1;
}

.radial-denom {
  font-size: 11px;
  font-weight: 600;
  color: var(--zth-text-secondary);
}

.hero-score-signals {
  display: flex;
  flex-direction: column;
  gap: 6px;
  flex: 1;
  min-width: 0;
}

.signal-headline-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.series-tier-badge {
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
  color: var(--zth-blue-electric);
  background: var(--zth-blue-pale);
  padding: 2px 6px;
  border-radius: 4px;
}

.company-name-heading {
  font-size: 14.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0;
}

.visual-scan-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.scan-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 4px;
}

.scan-pill.strong {
  background: #dcfce7;
  color: #15803d;
}

.scan-pill.warning {
  background: #fef3c7;
  color: #b45309;
}

.scan-pill.critical {
  background: #fee2e2;
  color: #b91c1c;
}

.visual-rubrics-dashboard {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 9px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.rubrics-dashboard-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 6px;
  border-bottom: 1px solid #f1f5f9;
}

.dashboard-section-kicker {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--zth-text-secondary);
}

.dashboard-hint {
  font-size: 11px;
  color: var(--zth-blue-electric);
  font-weight: 500;
}

.visual-rubric-bars-list {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.rubric-bar-row {
  display: flex;
  align-items: center;
  gap: 8px;
  width: 100%;
  padding: 4px 6px;
  border-radius: 5px;
  background: transparent;
  border: 1px solid transparent;
  cursor: pointer;
  transition: all var(--transition-fast);
  text-align: left;
}

.rubric-bar-row:hover {
  background: #f8fafc;
  border-color: #e2e8f0;
}

.rubric-bar-row.is-active-slide {
  background: var(--zth-blue-pale);
  border-color: #bfdbfe;
}

.rubric-bar-label-group {
  display: flex;
  align-items: center;
  gap: 6px;
  width: 160px;
  flex-shrink: 0;
}

.rubric-bar-name {
  font-size: 12px;
  font-weight: 500;
  color: var(--zth-navy-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rubric-slide-tag {
  font-size: 10px;
  font-weight: 700;
  color: #64748b;
  background: #f1f5f9;
  padding: 1px 4px;
  border-radius: 3px;
}

.rubric-bar-track {
  flex: 1;
  height: 5px;
  background: #f1f5f9;
  border-radius: 3px;
  overflow: hidden;
}

.rubric-bar-fill {
  height: 100%;
  border-radius: 3px;
  transition: width 0.5s ease;
}

.rubric-bar-fill.high { background: #15803d; }
.rubric-bar-fill.mid { background: #2563eb; }
.rubric-bar-fill.low { background: #d97706; }

.rubric-bar-val {
  font-size: 11.5px;
  font-weight: 700;
  width: 28px;
  text-align: right;
  flex-shrink: 0;
}

.rubric-bar-val.high { color: #15803d; }
.rubric-bar-val.mid { color: #2563eb; }
.rubric-bar-val.low { color: #d97706; }

.export-memo-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  width: 100%;
  height: 32px;
  background: #f8fafc;
  border: 1px solid var(--zth-border);
  border-radius: 6px;
  color: #334155;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.export-memo-btn:hover {
  background: #f1f5f9;
  color: var(--zth-navy-primary);
  border-color: #cbd5e1;
}

/* ==========================================================================
   Tab 2: Evidence Styles
   ========================================================================== */
.evidence-workspace {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.active-slide-visual-card {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 9px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.slide-visual-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.slide-pill-badge {
  font-size: 12px;
  font-weight: 700;
  color: var(--zth-navy-primary);
  background: #f1f5f9;
  padding: 3px 8px;
  border-radius: 4px;
}

.slide-verdict-tag {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 11px;
  font-weight: 600;
  padding: 2px 7px;
  border-radius: 4px;
}

.slide-verdict-tag.verified { background: #dcfce7; color: #15803d; }
.slide-verdict-tag.warning { background: #fef3c7; color: #b45309; }

.visual-tags-group {
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.tags-label {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--zth-text-secondary);
}

.tags-chips-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.proof-tag-chip {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  background: #f0fdf4;
  border: 1px solid #bbf7d0;
  border-radius: 4px;
  padding: 3px 8px;
  font-size: 11.5px;
  color: #14532d;
  font-weight: 500;
}

.visual-evidence-summary {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 8px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.evidence-summary-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.summary-heading {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
}

.summary-pct-badge {
  font-size: 11px;
  font-weight: 700;
  color: #15803d;
  background: #dcfce7;
  padding: 2px 6px;
  border-radius: 4px;
}

.coverage-progress-track {
  width: 100%;
  height: 5px;
  background: #f1f5f9;
  border-radius: 3px;
  overflow: hidden;
}

.coverage-progress-fill {
  height: 100%;
  background: #15803d;
  border-radius: 3px;
}

.coverage-subtext {
  font-size: 11px;
  color: var(--zth-text-secondary);
}

.slide-proof-matrix-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.proof-matrix-card {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 7px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 4px;
  text-align: left;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.proof-matrix-card:hover {
  border-color: #cbd5e1;
  box-shadow: 0 1px 3px rgba(11, 27, 51, 0.05);
}

.proof-matrix-card.is-active-slide {
  border-color: var(--zth-blue-electric);
  background: #f0f7ff;
}

.matrix-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.matrix-slide-badge {
  font-size: 10.5px;
  font-weight: 700;
  color: #64748b;
}

.matrix-status-icon.verified { color: #15803d; }
.matrix-status-icon.warning { color: #d97706; }
.matrix-status-icon.critical { color: #dc2626; }

.matrix-card-topic {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0;
}

.matrix-card-proof {
  font-size: 11px;
  color: var(--zth-text-secondary);
  line-height: 1.4;
  margin: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ==========================================================================
   Tab 3: Visual Risk Heatmap
   ========================================================================== */
.visual-risk-heatmap-header {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 8px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.heatmap-header-kicker {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--zth-text-secondary);
}

.severity-counters-row {
  display: flex;
  align-items: center;
  gap: 6px;
}

.severity-chip {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  padding: 6px 8px;
  border-radius: 6px;
}

.severity-chip.high { background: #fee2e2; color: #b91c1c; border: 1px solid #fecaca; }
.severity-chip.medium { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
.severity-chip.low { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }

.severity-chip .chip-count {
  font-size: 16px;
  font-weight: 700;
}

.severity-chip .chip-label {
  font-size: 11px;
  font-weight: 600;
}

.visual-risk-cards-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.visual-risk-action-card {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 8px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 5px;
}

.visual-risk-action-card.priority-high {
  border-left: 3px solid #ef4444;
}

.visual-risk-action-card.priority-medium {
  border-left: 3px solid #f59e0b;
}

.risk-action-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.risk-pill {
  font-size: 10.5px;
  font-weight: 700;
  text-transform: uppercase;
  padding: 2px 6px;
  border-radius: 3px;
}

.risk-pill.high { background: #fee2e2; color: #b91c1c; }
.risk-pill.medium { background: #fef3c7; color: #b45309; }

.risk-jump-pill {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  font-size: 10.5px;
  font-weight: 600;
  color: var(--zth-blue-electric);
  background: var(--zth-blue-pale);
  border: none;
  padding: 2px 7px;
  border-radius: 3px;
  cursor: pointer;
}

.risk-issue-headline {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--zth-navy-primary);
  margin: 0;
}

.risk-fix-banner {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  background: #f8fafc;
  border: 1px solid var(--zth-border);
  border-radius: 5px;
  padding: 6px 8px;
  font-size: 11.5px;
  color: #334155;
  line-height: 1.45;
}

.visual-missing-info-box {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 8px;
  padding: 10px 12px;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.missing-box-kicker {
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.05em;
  color: var(--zth-text-secondary);
}

.missing-tags-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.missing-tag-chip {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  background: #fffbeb;
  border: 1px solid #fde68a;
  border-radius: 4px;
  padding: 3px 7px;
  font-size: 11px;
  color: #92400e;
  font-weight: 500;
}

/* ==========================================================================
   Tab 4: Practice & Simulated Partner Interrogation
   ========================================================================== */
.interrogation-workspace {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.interrogation-question-box {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 9px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.topic-badge {
  font-size: 11px;
  font-weight: 600;
  color: var(--zth-blue-electric);
  background: var(--zth-blue-pale);
  padding: 2px 7px;
  border-radius: 4px;
}

.partner-question-quote {
  font-size: 13.5px;
  font-weight: 500;
  color: var(--zth-navy-primary);
  line-height: 1.5;
  margin: 0;
}

.why-partner-asks-box {
  display: flex;
  align-items: flex-start;
  gap: 6px;
  background: #f0f7ff;
  border: 1px solid #dbeafe;
  border-radius: 5px;
  padding: 8px 10px;
  font-size: 11.5px;
  color: #1e3a8a;
  line-height: 1.45;
}

.question-box-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 2px;
}

.next-question-btn {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  height: 30px;
  padding: 0 10px;
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  border: 1px solid #bfdbfe;
  border-radius: 5px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.next-question-btn:hover:not(:disabled) {
  background: #dbeafe;
}

.reset-history-btn {
  display: inline-flex;
  align-items: center;
  gap: 4px;
  height: 30px;
  padding: 0 8px;
  background: #f8fafc;
  border: 1px solid var(--zth-border);
  border-radius: 5px;
  font-size: 11.5px;
  color: var(--zth-text-secondary);
  cursor: pointer;
}

.founder-answer-card {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 9px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.answer-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.answer-header-row label {
  font-size: 12px;
  font-weight: 600;
  color: var(--zth-navy-primary);
}

.word-count-badge {
  font-size: 11px;
  color: var(--zth-text-secondary);
}

.starter-chips-container {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.starter-chip-pill {
  font-size: 11px;
  font-weight: 500;
  background: #f1f5f9;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 3px 8px;
  color: #334155;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.starter-chip-pill:hover {
  background: var(--zth-blue-pale);
  color: var(--zth-blue-electric);
  border-color: #bfdbfe;
}

.answer-textarea {
  font-family: inherit;
  font-size: 12.5px;
  line-height: 1.5;
  padding: 8px 10px;
  border: 1px solid var(--zth-border);
  border-radius: 6px;
  min-height: 80px;
  resize: vertical;
}

.answer-textarea:focus {
  border-color: var(--zth-blue-electric);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
  outline: none;
}

.submit-answer-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  height: 34px;
  padding: 0 16px;
  background: var(--zth-blue-electric);
  color: #ffffff;
  border-radius: 6px;
  border: none;
  font-size: 12.5px;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.submit-answer-btn:hover:not(:disabled) {
  background: var(--zth-blue-hover);
}

.submit-answer-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.partner-critique-card {
  background: #ffffff;
  border: 1px solid var(--zth-border);
  border-radius: 9px;
  padding: 12px 14px;
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.critique-score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.critique-pill-badge {
  font-size: 11px;
  font-weight: 700;
  color: var(--zth-blue-electric);
  background: var(--zth-blue-pale);
  padding: 2px 6px;
  border-radius: 4px;
}

.critique-verdict-text {
  font-size: 12.5px;
  line-height: 1.5;
  color: #334155;
  margin: 0;
}

/* Responsive & Reduced Motion */
@media (max-width: 900px) {
  .cockpit-studio-layout {
    flex-direction: column;
  }
  .cockpit-viewer-wrapper,
  .cockpit-console-wrapper {
    flex: none;
    width: 100%;
    max-width: 100%;
    height: auto;
  }
  .cockpit-main-frame {
    height: auto;
    overflow-y: auto;
  }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* ======================================================================
   Selective glass surfaces and compact interaction refinements
   ====================================================================== */
.glass-panel {
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid rgba(226, 232, 240, 0.78);
  box-shadow: 0 6px 20px rgba(15, 35, 65, 0.045), inset 0 1px 0 rgba(255, 255, 255, 0.8);
}

.glass-control {
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.24);
  transition:
    background 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease,
    transform 180ms ease;
}

.glass-control:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.98);
  border-color: rgba(59, 130, 246, 0.32);
  box-shadow: 0 3px 12px rgba(15, 35, 65, 0.07);
}

.glass-control:active:not(:disabled) {
  transform: translateY(1px);
}

.glass-control:focus-visible {
  outline: 2px solid var(--zth-blue-bright);
  outline-offset: 2px;
}

.glass-control:disabled {
  cursor: not-allowed;
}

.app-header {
  background: rgba(255, 255, 255, 0.88);
  backdrop-filter: blur(16px) saturate(150%);
  -webkit-backdrop-filter: blur(16px) saturate(150%);
  border-bottom-color: rgba(203, 213, 225, 0.68);
}

.workflow-stepper {
  background: rgba(255, 255, 255, 0.74);
  border-color: rgba(203, 213, 225, 0.68);
  box-shadow: 0 2px 8px rgba(11, 27, 51, 0.045), inset 0 1px 0 rgba(255, 255, 255, 0.88);
}

.dropzone-box.compact.glass-panel {
  background: rgba(248, 250, 252, 0.86);
  border: 1px dashed rgba(148, 163, 184, 0.72);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.92);
}

.dropzone-box.compact.glass-panel:hover:not(.disabled) {
  background: rgba(239, 246, 255, 0.9);
  border-color: rgba(59, 130, 246, 0.56);
}

.dropzone-box.compact.glass-panel.is-dragging {
  background: rgba(239, 246, 255, 0.96);
  border-color: var(--zth-blue-electric);
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.10), inset 0 1px 0 rgba(255, 255, 255, 0.95);
}

.persona-card.is-selected.glass-panel {
  background: rgba(239, 246, 255, 0.84);
  border-color: rgba(147, 197, 253, 0.72);
}

.modal-overlay {
  backdrop-filter: blur(8px) saturate(130%);
  -webkit-backdrop-filter: blur(8px) saturate(130%);
}

.modal-content {
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
}

@supports (backdrop-filter: blur(1px)) {
  .glass-panel {
    background: rgba(255, 255, 255, 0.74);
    border-color: rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(16px) saturate(150%);
    -webkit-backdrop-filter: blur(16px) saturate(150%);
  }

  .glass-control {
    background: rgba(255, 255, 255, 0.7);
  }

  .glass-control:hover:not(:disabled) {
    background: rgba(255, 255, 255, 0.92);
  }

  .dropzone-box.compact.glass-panel {
    background: rgba(248, 250, 252, 0.78);
    border-color: rgba(148, 163, 184, 0.72);
  }

  .dropzone-box.compact.glass-panel:hover:not(.disabled),
  .dropzone-box.compact.glass-panel.is-dragging {
    background: rgba(239, 246, 255, 0.88);
  }

  .persona-card.is-selected.glass-panel {
    background: rgba(239, 246, 255, 0.76);
    backdrop-filter: blur(12px) saturate(140%);
    -webkit-backdrop-filter: blur(12px) saturate(140%);
  }
}

@media (max-width: 768px) {
  .app-root.sidebar-is-collapsed .app-sidebar {
    left: -260px;
  }

  .app-root:not(.sidebar-is-collapsed) .app-sidebar {
    left: 0;
  }

  .viewer-pane-header {
    height: auto;
    min-height: 48px;
    flex-wrap: wrap;
    padding: 8px 12px;
    row-gap: 8px;
  }

  .viewer-title-group {
    flex: 1 1 180px;
  }

  .viewer-header-actions {
    order: 2;
    margin-left: auto;
  }

  .viewer-controls-group {
    order: 3;
    flex: 1 0 100%;
    justify-content: space-between;
  }
}

@media (max-width: 480px) {
  .app-header {
    gap: 6px;
    padding: 0 10px;
  }

  .header-left {
    flex: 0 0 auto;
    gap: 6px;
  }

  .header-center {
    flex: 1;
    min-width: 0;
  }

  .workflow-stepper {
    justify-content: space-between;
    gap: 0;
    padding: 2px;
  }

  .stepper-item {
    gap: 4px;
    padding: 4px 6px;
    font-size: 11px;
  }

  .stepper-connector {
    width: 4px;
  }

  .header-right {
    flex: 0 0 auto;
  }

  .header-settings-btn {
    width: 32px;
    justify-content: center;
    padding: 0;
  }

  .settings-btn-text,
  .viewer-slide-badge,
  .viewer-nav-btn span,
  .viewer-switch-btn span {
    display: none;
  }

  .viewer-title-group {
    flex-basis: 150px;
  }

  .viewer-controls-group {
    gap: 6px;
  }

  .viewer-nav-controls {
    gap: 2px;
  }

  .viewer-slide-counter {
    min-width: 36px;
    padding: 0 2px;
  }

  .viewer-switch-btn {
    width: 30px;
    justify-content: center;
    padding: 0;
  }
}


/* ==========================================================================
   ZTH DEFINITIVE HIGH-IMPACT GLASSMORPHISM ARCHITECTURE
   ========================================================================== */

/* 1. Luminous Ambient Workspace Atmosphere */
.app-root {
  min-height: 100vh !important;
  background-color: #f1f5f9 !important;
  background-image:
    radial-gradient(circle 650px at 12% 15%, rgba(59, 130, 246, 0.22) 0%, transparent 70%),
    radial-gradient(circle 550px at 85% 12%, rgba(99, 102, 241, 0.20) 0%, transparent 65%),
    radial-gradient(circle 600px at 50% 85%, rgba(14, 165, 233, 0.18) 0%, transparent 70%),
    radial-gradient(circle 450px at 80% 75%, rgba(168, 85, 247, 0.14) 0%, transparent 65%),
    linear-gradient(135deg, #f8fafc 0%, #eef2f7 45%, #e2e8f0 100%) !important;
  background-attachment: fixed !important;
  position: relative !important;
}

/* 2. Frosted Glass Top Navigation */
.app-header {
  height: 52px !important;
  background: rgba(255, 255, 255, 0.68) !important;
  backdrop-filter: blur(24px) saturate(180%) !important;
  -webkit-backdrop-filter: blur(24px) saturate(180%) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.85) !important;
  box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05), inset 0 -1px 0 rgba(255, 255, 255, 0.6) !important;
  z-index: 50 !important;
}

.workflow-stepper {
  background: rgba(255, 255, 255, 0.62) !important;
  backdrop-filter: blur(18px) saturate(170%) !important;
  -webkit-backdrop-filter: blur(18px) saturate(170%) !important;
  border: 1px solid rgba(255, 255, 255, 0.9) !important;
  box-shadow: 0 2px 12px rgba(15, 23, 42, 0.05), inset 0 1px 1px rgba(255, 255, 255, 0.95) !important;
}

.stepper-active-glider {
  background: rgba(255, 255, 255, 0.92) !important;
  backdrop-filter: blur(12px) !important;
  -webkit-backdrop-filter: blur(12px) !important;
  border: 1px solid rgba(255, 255, 255, 1) !important;
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.12), inset 0 1px 0 #ffffff !important;
}

.header-settings-btn {
  background: rgba(255, 255, 255, 0.65) !important;
  backdrop-filter: blur(14px) saturate(160%) !important;
  -webkit-backdrop-filter: blur(14px) saturate(160%) !important;
  border: 1px solid rgba(255, 255, 255, 0.85) !important;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.9) !important;
}

.header-settings-btn:hover {
  background: rgba(255, 255, 255, 0.85) !important;
  border-color: rgba(59, 130, 246, 0.5) !important;
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.15) !important;
}

/* 3. Deep Navy Frosted Sidebar */
.app-sidebar {
  background: rgba(11, 23, 44, 0.88) !important;
  backdrop-filter: blur(24px) saturate(170%) !important;
  -webkit-backdrop-filter: blur(24px) saturate(170%) !important;
  border-right: 1px solid rgba(255, 255, 255, 0.10) !important;
  box-shadow: 6px 0 24px rgba(0, 0, 0, 0.15) !important;
}

.sidebar-active-pill {
  background: linear-gradient(135deg, rgba(37, 99, 235, 0.35), rgba(37, 99, 235, 0.15)) !important;
  border: 1px solid rgba(96, 165, 250, 0.35) !important;
  backdrop-filter: blur(12px) !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.2), 0 2px 8px rgba(37, 99, 235, 0.25) !important;
}

.sidebar-footer-card {
  background: rgba(255, 255, 255, 0.06) !important;
  backdrop-filter: blur(16px) !important;
  -webkit-backdrop-filter: blur(16px) !important;
  border: 1px solid rgba(255, 255, 255, 0.12) !important;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15) !important;
}

/* 4. Split Cockpit Architecture */
.cockpit-main-frame {
  background: transparent !important;
}

.cockpit-studio-layout {
  background: transparent !important;
}

.cockpit-viewer-wrapper {
  background: transparent !important;
  border-right: 1px solid rgba(226, 232, 240, 0.70) !important;
}

.cockpit-viewer-pane {
  background: transparent !important;
}

.viewer-pane-header {
  height: 48px !important;
  background: rgba(255, 255, 255, 0.65) !important;
  backdrop-filter: blur(20px) saturate(170%) !important;
  -webkit-backdrop-filter: blur(20px) saturate(170%) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.8) !important;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03) !important;
}

.viewer-slide-stage {
  background-color: transparent !important;
  background-image: radial-gradient(rgba(99, 102, 241, 0.16) 1.2px, transparent 1.2px) !important;
  background-size: 24px 24px !important;
  position: relative !important;
}

/* 5. Floating Frosted Glass Upload Stage Card */
.viewer-upload-card {
  background: rgba(255, 255, 255, 0.68) !important;
  backdrop-filter: blur(26px) saturate(190%) !important;
  -webkit-backdrop-filter: blur(26px) saturate(190%) !important;
  border: 1px solid rgba(255, 255, 255, 0.90) !important;
  border-radius: 20px !important;
  padding: 36px 32px !important;
  box-shadow:
    0 24px 60px -12px rgba(37, 99, 235, 0.16),
    0 10px 24px -6px rgba(15, 23, 42, 0.08),
    inset 0 1px 2px rgba(255, 255, 255, 1) !important;
  transition: transform 0.2s ease, box-shadow 0.2s ease !important;
}

.viewer-upload-card:hover {
  transform: translateY(-2px) !important;
  box-shadow:
    0 30px 70px -15px rgba(37, 99, 235, 0.22),
    0 14px 28px -6px rgba(15, 23, 42, 0.10),
    inset 0 1px 2px rgba(255, 255, 255, 1) !important;
}

.viewer-upload-icon-circle {
  background: rgba(239, 246, 255, 0.9) !important;
  border: 1px solid rgba(191, 219, 254, 0.8) !important;
  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.15), inset 0 1px 0 #ffffff !important;
}

/* 6. Frosted Glass Slide Canvas Presentation Card */
.slide-canvas-card {
  background: rgba(255, 255, 255, 0.82) !important;
  backdrop-filter: blur(24px) saturate(180%) !important;
  -webkit-backdrop-filter: blur(24px) saturate(180%) !important;
  border: 1px solid rgba(255, 255, 255, 0.95) !important;
  border-radius: 16px !important;
  box-shadow:
    0 20px 50px -12px rgba(15, 23, 42, 0.12),
    0 8px 20px -4px rgba(15, 23, 42, 0.06),
    inset 0 1px 2px rgba(255, 255, 255, 1) !important;
}

.executive-card,
.problem-card,
.pipeline-node-card,
.structured-bullet-card {
  background: rgba(255, 255, 255, 0.65) !important;
  backdrop-filter: blur(16px) saturate(160%) !important;
  -webkit-backdrop-filter: blur(16px) saturate(160%) !important;
  border: 1px solid rgba(255, 255, 255, 0.85) !important;
  box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04), inset 0 1px 0 #ffffff !important;
}

/* 7. Right AI Console Frosted Glass Panel */
.cockpit-console-wrapper {
  background: rgba(255, 255, 255, 0.64) !important;
  backdrop-filter: blur(28px) saturate(190%) !important;
  -webkit-backdrop-filter: blur(28px) saturate(190%) !important;
  border-left: 1px solid rgba(255, 255, 255, 0.85) !important;
  box-shadow:
    -10px 0 36px rgba(15, 23, 42, 0.06),
    inset 1px 0 0 rgba(255, 255, 255, 0.9) !important;
}

.console-segmented-header {
  height: 48px !important;
  background: rgba(255, 255, 255, 0.60) !important;
  backdrop-filter: blur(20px) saturate(170%) !important;
  -webkit-backdrop-filter: blur(20px) saturate(170%) !important;
  border-bottom: 1px solid rgba(255, 255, 255, 0.8) !important;
}

.segmented-tab-group {
  background: rgba(241, 245, 249, 0.65) !important;
  backdrop-filter: blur(12px) !important;
  -webkit-backdrop-filter: blur(12px) !important;
  border: 1px solid rgba(255, 255, 255, 0.8) !important;
  border-radius: 8px !important;
  padding: 3px !important;
}

.segmented-tab-btn.is-active {
  background: rgba(255, 255, 255, 0.95) !important;
  backdrop-filter: blur(8px) !important;
  border: 1px solid rgba(255, 255, 255, 1) !important;
  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.08), inset 0 1px 0 #ffffff !important;
  color: var(--zth-blue-electric) !important;
  font-weight: 600 !important;
}

.console-body {
  background: transparent !important;
}

/* 8. Console Input Controls & Cards Glassmorphism */
.dropzone-box.compact {
  background: rgba(255, 255, 255, 0.58) !important;
  backdrop-filter: blur(16px) saturate(160%) !important;
  -webkit-backdrop-filter: blur(16px) saturate(160%) !important;
  border: 1.5px dashed rgba(59, 130, 246, 0.40) !important;
  box-shadow: 0 4px 16px rgba(15, 23, 42, 0.03), inset 0 1px 1px rgba(255, 255, 255, 0.9) !important;
}

.dropzone-box.compact:hover {
  background: rgba(239, 246, 255, 0.80) !important;
  border-color: rgba(37, 99, 235, 0.65) !important;
  box-shadow: 0 6px 20px rgba(37, 99, 235, 0.12), inset 0 1px 1px #ffffff !important;
}

.stage-select-btn {
  background: rgba(255, 255, 255, 0.55) !important;
  backdrop-filter: blur(12px) !important;
  -webkit-backdrop-filter: blur(12px) !important;
  border: 1px solid rgba(255, 255, 255, 0.85) !important;
  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.03), inset 0 1px 0 rgba(255, 255, 255, 0.9) !important;
}

.stage-select-btn:hover {
  background: rgba(255, 255, 255, 0.85) !important;
  border-color: rgba(59, 130, 246, 0.4) !important;
}

.stage-select-btn.is-active {
  background: rgba(239, 246, 255, 0.85) !important;
  border-color: rgba(37, 99, 235, 0.65) !important;
  color: #1d4ed8 !important;
  font-weight: 600 !important;
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.16), inset 0 1px 0 #ffffff !important;
}

.profile-input-field {
  background: rgba(255, 255, 255, 0.65) !important;
  backdrop-filter: blur(12px) !important;
  -webkit-backdrop-filter: blur(12px) !important;
  border: 1px solid rgba(255, 255, 255, 0.9) !important;
  box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.04), 0 1px 2px rgba(255, 255, 255, 0.8) !important;
}

.profile-input-field:focus {
  background: rgba(255, 255, 255, 0.90) !important;
  border-color: var(--zth-blue-electric) !important;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15), inset 0 1px 1px #ffffff !important;
}

.sector-pill {
  background: rgba(255, 255, 255, 0.58) !important;
  backdrop-filter: blur(10px) !important;
  -webkit-backdrop-filter: blur(10px) !important;
  border: 1px solid rgba(255, 255, 255, 0.85) !important;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03), inset 0 1px 0 rgba(255, 255, 255, 0.8) !important;
}

.sector-pill:hover {
  background: rgba(239, 246, 255, 0.85) !important;
  border-color: rgba(59, 130, 246, 0.5) !important;
  color: var(--zth-blue-electric) !important;
}

.startup-details-accordion,
.startup-context-card {
  background: rgba(255, 255, 255, 0.52) !important;
  backdrop-filter: blur(14px) !important;
  -webkit-backdrop-filter: blur(14px) !important;
  border: 1px solid rgba(255, 255, 255, 0.85) !important;
  box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.9) !important;
}

/* 9. Review & Practice Screens Glassmorphism */
.dashboard-hero {
  background: rgba(255, 255, 255, 0.68) !important;
  backdrop-filter: blur(24px) saturate(180%) !important;
  -webkit-backdrop-filter: blur(24px) saturate(180%) !important;
  border: 1px solid rgba(255, 255, 255, 0.90) !important;
  box-shadow: 0 16px 40px -8px rgba(15, 23, 42, 0.08), inset 0 1px 2px #ffffff !important;
}

.readiness-score-card,
.category-card,
.side-widget-card,
.dashboard-main-card {
  background: rgba(255, 255, 255, 0.68) !important;
  backdrop-filter: blur(22px) saturate(180%) !important;
  -webkit-backdrop-filter: blur(22px) saturate(180%) !important;
  border: 1px solid rgba(255, 255, 255, 0.90) !important;
  box-shadow: 0 10px 30px -4px rgba(15, 23, 42, 0.06), inset 0 1px 1px #ffffff !important;
}

.persona-card {
  background: rgba(255, 255, 255, 0.62) !important;
  backdrop-filter: blur(18px) saturate(160%) !important;
  -webkit-backdrop-filter: blur(18px) saturate(160%) !important;
  border: 1px solid rgba(255, 255, 255, 0.85) !important;
  box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04), inset 0 1px 0 #ffffff !important;
}

.persona-card.is-selected {
  background: rgba(239, 246, 255, 0.82) !important;
  border-color: rgba(37, 99, 235, 0.70) !important;
  box-shadow: 0 8px 24px rgba(37, 99, 235, 0.18), inset 0 1px 0 #ffffff !important;
}

.simulation-card,
.feedback-box,
.chat-exchange-card {
  background: rgba(255, 255, 255, 0.68) !important;
  backdrop-filter: blur(20px) saturate(170%) !important;
  -webkit-backdrop-filter: blur(20px) saturate(170%) !important;
  border: 1px solid rgba(255, 255, 255, 0.88) !important;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05), inset 0 1px 1px #ffffff !important;
}

/* 10. Modals Glassmorphism */
.modal-overlay {
  background: rgba(11, 23, 44, 0.50) !important;
  backdrop-filter: blur(14px) saturate(150%) !important;
  -webkit-backdrop-filter: blur(14px) saturate(150%) !important;
}

.modal-content {
  background: rgba(255, 255, 255, 0.85) !important;
  backdrop-filter: blur(28px) saturate(190%) !important;
  -webkit-backdrop-filter: blur(28px) saturate(190%) !important;
  border: 1px solid rgba(255, 255, 255, 0.95) !important;
  box-shadow:
    0 24px 60px -10px rgba(0, 0, 0, 0.25),
    0 10px 25px -5px rgba(0, 0, 0, 0.10),
    inset 0 1px 2px #ffffff !important;
}

.preset-pill-btn {
  background: rgba(255, 255, 255, 0.65) !important;
  backdrop-filter: blur(10px) !important;
  -webkit-backdrop-filter: blur(10px) !important;
  border: 1px solid rgba(255, 255, 255, 0.85) !important;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03), inset 0 1px 0 #ffffff !important;
}

.preset-pill-btn:hover {
  background: rgba(239, 246, 255, 0.90) !important;
  border-color: rgba(59, 130, 246, 0.5) !important;
}

/* 11. Generic Glass Utilities */
.glass-panel {
  background: rgba(255, 255, 255, 0.68) !important;
  backdrop-filter: blur(20px) saturate(180%) !important;
  -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
  border: 1px solid rgba(255, 255, 255, 0.88) !important;
  box-shadow: 0 10px 30px -4px rgba(15, 23, 42, 0.06), inset 0 1px 1px rgba(255, 255, 255, 0.95) !important;
}

.glass-panel--strong {
  background: rgba(255, 255, 255, 0.84) !important;
  backdrop-filter: blur(28px) saturate(190%) !important;
  -webkit-backdrop-filter: blur(28px) saturate(190%) !important;
  border: 1px solid rgba(255, 255, 255, 0.95) !important;
  box-shadow: 0 20px 50px -10px rgba(15, 23, 42, 0.15), inset 0 1px 2px #ffffff !important;
}

.glass-control {
  background: rgba(255, 255, 255, 0.65) !important;
  backdrop-filter: blur(12px) !important;
  -webkit-backdrop-filter: blur(12px) !important;
  border: 1px solid rgba(255, 255, 255, 0.85) !important;
  box-shadow: 0 2px 6px rgba(15, 23, 42, 0.04), inset 0 1px 0 rgba(255, 255, 255, 0.9) !important;
  transition: all 180ms ease !important;
}

.glass-control:hover:not(:disabled) {
  background: rgba(255, 255, 255, 0.88) !important;
  border-color: rgba(59, 130, 246, 0.45) !important;
  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.12), inset 0 1px 0 #ffffff !important;
  transform: translateY(-0.5px) !important;
}


/* ==========================================================================
   LUMINOUS AMBIENT GLOW ORBS FOR UNMISTAKABLE FROSTED GLASS REFRACTION
   ========================================================================== */

.viewer-slide-stage {
  position: relative !important;
  overflow: hidden !important;
  background: #f1f5f9 !important;
}

.viewer-slide-stage::before {
  content: '' !important;
  position: absolute !important;
  width: 540px !important;
  height: 540px !important;
  top: 45% !important;
  left: 48% !important;
  transform: translate(-50%, -50%) !important;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.45) 0%, rgba(99, 102, 241, 0.35) 45%, rgba(56, 189, 248, 0.20) 70%, transparent 80%) !important;
  filter: blur(50px) !important;
  border-radius: 50% !important;
  pointer-events: none !important;
  z-index: 0 !important;
  animation: orb-pulse 8s ease-in-out infinite alternate !important;
}

.viewer-slide-stage::after {
  content: '' !important;
  position: absolute !important;
  width: 400px !important;
  height: 400px !important;
  top: 25% !important;
  right: 18% !important;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.35) 0%, rgba(217, 70, 239, 0.22) 50%, transparent 75%) !important;
  filter: blur(55px) !important;
  border-radius: 50% !important;
  pointer-events: none !important;
  z-index: 0 !important;
  animation: orb-pulse-alt 10s ease-in-out infinite alternate !important;
}

@keyframes orb-pulse {
  0% { transform: translate(-50%, -50%) scale(0.95); opacity: 0.85; }
  100% { transform: translate(-50%, -50%) scale(1.08); opacity: 1; }
}

@keyframes orb-pulse-alt {
  0% { transform: scale(1); opacity: 0.75; }
  100% { transform: scale(1.12) translate(-20px, 15px); opacity: 0.95; }
}

.viewer-upload-stage {
  position: relative !important;
  z-index: 1 !important;
}

/* Translucent Glass Upload Card */
.viewer-upload-card {
  position: relative !important;
  z-index: 1 !important;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 255, 255, 0.42) 100%) !important;
  backdrop-filter: blur(28px) saturate(200%) !important;
  -webkit-backdrop-filter: blur(28px) saturate(200%) !important;
  border: 1px solid rgba(255, 255, 255, 0.95) !important;
  border-radius: 20px !important;
  box-shadow:
    0 30px 60px -15px rgba(15, 35, 65, 0.18),
    0 12px 28px -5px rgba(37, 99, 235, 0.15),
    inset 0 1.5px 2px rgba(255, 255, 255, 1),
    inset 0 -1px 1px rgba(0, 0, 0, 0.05) !important;
}

.viewer-upload-icon-circle {
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.9) 0%, rgba(219, 234, 254, 0.6) 100%) !important;
  backdrop-filter: blur(14px) !important;
  border: 1px solid rgba(255, 255, 255, 0.9) !important;
  box-shadow: 0 4px 16px rgba(37, 99, 235, 0.18), inset 0 1px 0 #ffffff !important;
}

.viewer-upload-browse-btn {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
  box-shadow: 0 4px 16px rgba(37, 99, 235, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.25) !important;
  border: 1px solid rgba(255, 255, 255, 0.2) !important;
  transition: all 0.2s ease !important;
}

.viewer-upload-browse-btn:hover {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%) !important;
  box-shadow: 0 6px 22px rgba(37, 99, 235, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.35) !important;
  transform: translateY(-1px) !important;
}

/* Translucent Frosted Glass Console */
.cockpit-console-wrapper {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 255, 255, 0.55) 100%) !important;
  backdrop-filter: blur(30px) saturate(200%) !important;
  -webkit-backdrop-filter: blur(30px) saturate(200%) !important;
  border-left: 1px solid rgba(255, 255, 255, 0.9) !important;
  box-shadow:
    -12px 0 40px rgba(15, 23, 42, 0.08),
    inset 1px 0 0 rgba(255, 255, 255, 0.95) !important;
  position: relative !important;
}

.cockpit-console-wrapper::before {
  content: '' !important;
  position: absolute !important;
  width: 280px !important;
  height: 280px !important;
  top: 15% !important;
  right: -50px !important;
  background: radial-gradient(circle, rgba(59, 130, 246, 0.20) 0%, rgba(99, 102, 241, 0.12) 50%, transparent 70%) !important;
  filter: blur(40px) !important;
  pointer-events: none !important;
  z-index: 0 !important;
}

.console-tab-content {
  position: relative !important;
  z-index: 1 !important;
}

/* Dropzone Box Glass */
.dropzone-box.compact {
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.65) 0%, rgba(239, 246, 255, 0.45) 100%) !important;
  backdrop-filter: blur(20px) saturate(180%) !important;
  -webkit-backdrop-filter: blur(20px) saturate(180%) !important;
  border: 1.5px dashed rgba(59, 130, 246, 0.50) !important;
  border-radius: 12px !important;
  box-shadow: 0 4px 18px rgba(37, 99, 235, 0.08), inset 0 1px 1px rgba(255, 255, 255, 1) !important;
}

.dropzone-box.compact:hover {
  background: linear-gradient(135deg, rgba(239, 246, 255, 0.85) 0%, rgba(219, 234, 254, 0.65) 100%) !important;
  border-color: rgba(37, 99, 235, 0.8) !important;
  box-shadow: 0 8px 24px rgba(37, 99, 235, 0.18), inset 0 1px 1px #ffffff !important;
}

/* Stage Pill Buttons Glass */
.stage-pill-selector {
  background: rgba(255, 255, 255, 0.50) !important;
  backdrop-filter: blur(16px) !important;
  -webkit-backdrop-filter: blur(16px) !important;
  border: 1px solid rgba(255, 255, 255, 0.9) !important;
  border-radius: 10px !important;
  padding: 3px !important;
  box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.04) !important;
}

.stage-pill-btn {
  border-radius: 7px !important;
  font-weight: 500 !important;
  transition: all 0.18s ease !important;
}

.stage-pill-btn.active {
  background: rgba(255, 255, 255, 0.95) !important;
  backdrop-filter: blur(12px) !important;
  color: #1d4ed8 !important;
  font-weight: 600 !important;
  border: 1px solid rgba(255, 255, 255, 1) !important;
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.18), inset 0 1px 0 #ffffff !important;
}

/* Input Fields Glass */
.form-field input {
  background: rgba(255, 255, 255, 0.65) !important;
  backdrop-filter: blur(14px) !important;
  -webkit-backdrop-filter: blur(14px) !important;
  border: 1px solid rgba(255, 255, 255, 0.95) !important;
  border-radius: 8px !important;
  box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.05), 0 1px 2px rgba(255, 255, 255, 0.8) !important;
  transition: all 0.18s ease !important;
}

.form-field input:focus {
  background: rgba(255, 255, 255, 0.92) !important;
  border-color: #3b82f6 !important;
  box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.18), inset 0 1px 1px #ffffff !important;
}

/* Industry Quick Chips Glass */
.industry-chip-btn {
  background: rgba(255, 255, 255, 0.55) !important;
  backdrop-filter: blur(10px) !important;
  -webkit-backdrop-filter: blur(10px) !important;
  border: 1px solid rgba(255, 255, 255, 0.85) !important;
  box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03), inset 0 1px 0 rgba(255, 255, 255, 0.9) !important;
  transition: all 0.18s ease !important;
}

.industry-chip-btn:hover {
  background: rgba(239, 246, 255, 0.9) !important;
  border-color: rgba(59, 130, 246, 0.5) !important;
  color: #1d4ed8 !important;
  transform: translateY(-0.5px) !important;
}

.industry-chip-btn.active {
  background: rgba(37, 99, 235, 0.12) !important;
  border-color: rgba(37, 99, 235, 0.6) !important;
  color: #1d4ed8 !important;
  font-weight: 600 !important;
  box-shadow: 0 2px 6px rgba(37, 99, 235, 0.12), inset 0 1px 0 #ffffff !important;
}

/* Details Toggle Glass */
.details-toggle-btn {
  background: rgba(255, 255, 255, 0.55) !important;
  backdrop-filter: blur(14px) !important;
  -webkit-backdrop-filter: blur(14px) !important;
  border: 1px solid rgba(255, 255, 255, 0.88) !important;
  border-radius: 9px !important;
  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03), inset 0 1px 0 rgba(255, 255, 255, 0.95) !important;
}

.details-toggle-btn:hover {
  background: rgba(255, 255, 255, 0.85) !important;
  border-color: rgba(59, 130, 246, 0.45) !important;
}

.optional-details-panel {
  background: rgba(255, 255, 255, 0.52) !important;
  backdrop-filter: blur(18px) !important;
  -webkit-backdrop-filter: blur(18px) !important;
  border: 1px solid rgba(255, 255, 255, 0.88) !important;
  border-radius: 12px !important;
  box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05), inset 0 1px 1px rgba(255, 255, 255, 0.95) !important;
}

/* Console Evaluate Primary Button */
.console-evaluate-btn {
  background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%) !important;
  border: 1px solid rgba(255, 255, 255, 0.25) !important;
  box-shadow: 0 6px 20px rgba(37, 99, 235, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.3) !important;
  transition: all 0.2s ease !important;
}

.console-evaluate-btn:hover:not(:disabled) {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%) !important;
  box-shadow: 0 8px 26px rgba(37, 99, 235, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.4) !important;
  transform: translateY(-1px) !important;
}


/* ==========================================================================
   PERFECT SEAMLESS GLASS WORKSPACE BACKGROUND
   ========================================================================== */
.cockpit-main-frame {
  height: calc(100vh - 52px) !important;
  display: flex !important;
  overflow: hidden !important;
  background: transparent !important;
}

.cockpit-studio-layout {
  display: flex !important;
  width: 100% !important;
  height: 100% !important;
  overflow: hidden !important;
  background: transparent !important;
}

.cockpit-viewer-wrapper {
  flex: 1.5 !important;
  height: 100% !important;
  display: flex !important;
  flex-direction: column !important;
  background: transparent !important;
  border-right: 1px solid rgba(226, 232, 240, 0.75) !important;
  overflow: hidden !important;
}

.cockpit-viewer-pane {
  display: flex !important;
  flex-direction: column !important;
  height: 100% !important;
  width: 100% !important;
  overflow: hidden !important;
  background: transparent !important;
}

.viewer-slide-stage {
  flex: 1 !important;
  height: calc(100% - 48px) !important;
  min-height: 0 !important;
  position: relative !important;
  overflow: auto !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  padding: 32px !important;
  background: transparent !important;
}

/* Ambient glow orbs floating on the stage */
.viewer-slide-stage::before {
  content: '' !important;
  position: absolute !important;
  width: 600px !important;
  height: 600px !important;
  top: 50% !important;
  left: 50% !important;
  transform: translate(-50%, -50%) !important;
  background: radial-gradient(circle, rgba(37, 99, 235, 0.35) 0%, rgba(99, 102, 241, 0.25) 45%, rgba(56, 189, 248, 0.15) 70%, transparent 80%) !important;
  filter: blur(60px) !important;
  border-radius: 50% !important;
  pointer-events: none !important;
  z-index: 0 !important;
}

.viewer-slide-stage::after {
  content: '' !important;
  position: absolute !important;
  width: 450px !important;
  height: 450px !important;
  top: 30% !important;
  right: 10% !important;
  background: radial-gradient(circle, rgba(139, 92, 246, 0.30) 0%, rgba(217, 70, 239, 0.18) 50%, transparent 75%) !important;
  filter: blur(65px) !important;
  border-radius: 50% !important;
  pointer-events: none !important;
  z-index: 0 !important;
}

.viewer-upload-stage {
  position: relative !important;
  z-index: 1 !important;
  width: 100% !important;
  display: flex !important;
  justify-content: center !important;
  align-items: center !important;
}

.cockpit-console-wrapper {
  width: 440px !important;
  min-width: 380px !important;
  max-width: 480px !important;
  height: 100% !important;
  display: flex !important;
  flex-direction: column !important;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.75) 0%, rgba(255, 255, 255, 0.60) 100%) !important;
  backdrop-filter: blur(30px) saturate(200%) !important;
  -webkit-backdrop-filter: blur(30px) saturate(200%) !important;
  border-left: 1px solid rgba(255, 255, 255, 0.9) !important;
  box-shadow: -12px 0 40px rgba(15, 23, 42, 0.08), inset 1px 0 0 rgba(255, 255, 255, 0.95) !important;
  overflow: hidden !important;
}

.cockpit-console-pane {
  display: flex !important;
  flex-direction: column !important;
  height: 100% !important;
  width: 100% !important;
  overflow: hidden !important;
  background: transparent !important;
}

.console-tab-content {
  flex: 1 !important;
  overflow-y: auto !important;
  padding: 16px !important;
  background: transparent !important;
}
